    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@fashion.local"
    },
