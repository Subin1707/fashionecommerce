            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is expected\", function () { pm.expect([200]).to.include(pm.response.code); });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  var json = pm.response.json();",
                  "  var value = json.items && json.items[json.items.length - 1] && json.items[json.items.length - 1].id;",
                  "  if (value !== undefined && value !== null) { pm.collectionVariables.set(\"cartItemId\", value); }",
                  "}"
                ]
              }
            }
          ]
        },
