# Backend demo accounts
FASHION_ADMIN_PASSWORD=change_me_admin_password
FASHION_CUSTOMER_PASSWORD=change_me_customer_password

# JWT
FASHION_JWT_SECRET=replace_with_at_least_32_bytes_secret
FASHION_JWT_EXPIRATION_MS=86400000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fashion
DB_USERNAME=fashion
DB_PASSWORD=change_me_database_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# Elasticsearch
ELASTICSEARCH_URI=http://localhost:9200

# VNPay sandbox placeholders
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_RETURN_URL=http://localhost:8081/api/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/#orders

# Map services
GEOCODING_PROVIDER=photon
GEOCODING_URL=https://photon.komoot.io
ROUTING_URL=https://router.project-osrm.org
MAPS_USER_AGENT=FashionShopDemo/1.0
SHIPPING_SIMULATOR_ENABLED=true

# Frontend optional map key
VITE_CARTO_API_KEY=
