# Local demo account passwords. Override before starting the backend.
FASHION_ADMIN_PASSWORD=change_me_admin_password
FASHION_CUSTOMER_PASSWORD=change_me_customer_password

# Replace with a random secret of at least 32 bytes before running the backend.
FASHION_JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
FASHION_JWT_EXPIRATION_MS=86400000

# PostgreSQL settings read by Spring Boot. Compose local demo defaults:
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/fashion
SPRING_DATASOURCE_USERNAME=fashion
SPRING_DATASOURCE_PASSWORD=change_me_database_password

# Optional SMTP for email OTP registration:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional integrations; application defaults are documented in README.md.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PUBLIC_BASE_URL=
VNPAY_RETURN_URL=
VNPAY_FRONTEND_RETURN_URL=
GEOCODING_PROVIDER=photon
GEOCODING_URL=https://photon.komoot.io
ROUTING_URL=https://router.project-osrm.org
MAPS_USER_AGENT=FashionShopDemo/1.0
SHIPPING_SIMULATOR_ENABLED=true
