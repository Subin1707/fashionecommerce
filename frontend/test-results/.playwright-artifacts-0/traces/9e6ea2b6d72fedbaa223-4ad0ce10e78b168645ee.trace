uto;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.variant-row input {\r\n  padding: 8px 10px;\r\n  border: 1px solid #d5cbbf;\r\n  border-radius: 6px;\r\n  background: #fff;\r\n  font-size: 0.9rem;\r\n}\r\n\r\n.variant-row button {\r\n  padding: 8px 14px;\r\n}\r\n\r\n@media (max-width: 680px) {\r\n  .variant-row {\r\n    grid-template-columns: 1fr 1fr;\r\n  }\r\n}\r\n\r\n.admin-product-submit-row {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n\r\n.admin-product-submit-row button {\r\n  min-width: 150px;\r\n}\r\n\r\n.admin-product-empty-editor p {\r\n  color: #6f6860;\r\n  line-height: 1.6;\r\n}\r\n\r\n.admin-product-loading {\r\n  min-height: 340px;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  background: linear-gradient(90deg, #eee7de 0%, #fffdf9 50%, #eee7de 100%);\r\n  background-size: 220% 100%;\r\n  animation: detail-loading 1.2s ease-in-out infinite;\r\n}\r\n\r\n.inventory-page {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.inventory-hero,\r\n.inventory-toolbar,\r\n.inventory-product-panel,\r\n.inventory-sku-panel {\r\n  min-width: 0;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42, 34, 26, 0.07);\r\n}\r\n\r\n.inventory-hero {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 18px;\r\n  align-items: flex-start;\r\n  padding: 24px;\r\n}\r\n\r\n.inventory-hero h1 {\r\n  max-width: 760px;\r\n}\r\n\r\n.inventory-hero p:last-child {\r\n  max-width: 720px;\r\n  margin-top: 8px;\r\n  color: #6f6860;\r\n  line-height: 1.65;\r\n}\r\n\r\n.inventory-hero button {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.inventory-kpi-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.inventory-kpi {\r\n  display: grid;\r\n  gap: 8px;\r\n  min-height: 104px;\r\n  padding: 16px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n}\r\n\r\n.inventory-kpi span,\r\n.inventory-product