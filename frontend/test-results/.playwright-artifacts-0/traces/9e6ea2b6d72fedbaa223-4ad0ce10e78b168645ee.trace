dden;\r\n}\r\n\r\n.measure-input input {\r\n  border: 0;\r\n  border-radius: 0;\r\n}\r\n\r\n.measure-input span {\r\n  padding: 0 12px;\r\n  color: #6f6860;\r\n  font-size: 12px;\r\n  font-weight: 900;\r\n}\r\n\r\n.body-insight-card {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.body-insight-card div {\r\n  display: grid;\r\n  gap: 6px;\r\n  padding: 12px;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n}\r\n\r\n.body-insight-card span,\r\n.size-result-card > span,\r\n.size-result-card small {\r\n  color: #6f6860;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n}\r\n\r\n.body-insight-card strong {\r\n  color: #1f1d1a;\r\n}\r\n\r\n.style-wide-field {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.style-result-panel {\r\n  position: sticky;\r\n  top: 24px;\r\n}\r\n\r\n.size-result-card {\r\n  background:\r\n    linear-gradient(145deg, rgba(168, 90, 61, 0.92), rgba(31, 29, 26, 0.92)),\r\n    #a85a3d;\r\n  color: #fffdf9;\r\n}\r\n\r\n.size-result-card .eyebrow {\r\n  margin: 0;\r\n  color: #f3d79e;\r\n}\r\n\r\n.size-result-card > strong {\r\n  font-size: clamp(46px, 8vw, 72px);\r\n  line-height: 0.9;\r\n}\r\n\r\n.size-result-card > span,\r\n.size-result-card p,\r\n.size-result-card small {\r\n  color: #f4e8dc;\r\n}\r\n\r\n.style-chat-reply p:last-child {\r\n  line-height: 1.7;\r\n  color: #554c43;\r\n}\r\n\r\n.style-empty-state {\r\n  padding: 16px;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n  color: #6f6860;\r\n  font-weight: 700;\r\n}\r\n\r\n.style-product-grid {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.style-product-card {\r\n  display: grid;\r\n  grid-template-columns: 92px minmax(0, 1fr) auto;\r\n  gap: 12px;\r\n  align-items: center;\r\n  padding: 12px;\r\n  border: 1px solid #eee7de;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n}\r\n\r\n.style-product-image {\r\n  aspect-ratio: 4 / 5;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\