lock;\r\n}\r\n\r\n.brand-mark strong { font-size: 14px; }\r\n.brand-mark small { margin-top: 3px; font-size: 10px; line-height: 1.3; }\r\n\r\n.brand-mark small,\r\n.eyebrow,\r\n.notice,\r\n.product-card p,\r\n.detail-panel p,\r\n.metric-card span,\r\n.empty-state,\r\ntd {\r\n  color: #6f6860;\r\n}\r\n\r\nnav {\r\n  display: grid;\r\n  gap: 5px;\r\n}\r\n\r\nbutton,\r\ninput,\r\nselect,\r\ntextarea {\r\n  font: inherit;\r\n}\r\n\r\nbutton {\r\n  min-height: 40px;\r\n  border: 0;\r\n  border-radius: 8px;\r\n  padding: 0 14px;\r\n  color: #fff;\r\n  background: #1d1c1a;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n  background: #47423b;\r\n}\r\n\r\nbutton.ghost,\r\nnav button {\r\n  color: #201f1d;\r\n  background: #eee7de;\r\n}\r\n\r\nnav button {\r\n  min-height: 38px;\r\n  padding: 0 12px;\r\n  font-size: 13px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  text-align: left;\r\n}\r\n\r\n.cart-nav-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 18px;\r\n  height: 18px;\r\n  padding: 0 5px;\r\n  border-radius: 999px;\r\n  background: #d1aa68;\r\n  color: #1a1815;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  line-height: 1;\r\n}\r\n\r\nnav button.active .cart-nav-badge {\r\n  background: #ffffff;\r\n  color: #9d533b;\r\n}\r\n\r\nnav button.active,\r\nbutton.ghost:hover,\r\nnav button:hover {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\ninput,\r\nselect,\r\ntextarea {\r\n  min-height: 40px;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  padding: 8px 10px;\r\n  background: #fff;\r\n  color: #201f1d;\r\n}\r\n\r\ntextarea {\r\n  min-height: 94px;\r\n  resize: vertical;\r\n}\r\n\r\nlabel {\r\n  display: grid;\r\n  gap: 6px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #47423b;\r\n}\r\n\r\n.login-panel,\r\n.checkout-panel,\r\n.detail-panel,\r\n.table-panel {\r\n  display: grid;\r\n  gap: 14px;\r\n  padding: 14px;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n}\r\n\r\n.login-panel {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.login-panel strong,\r\n.login-panel small {\r\n  display: block;\r\n  max-width: 100%;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.login-panel button {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.workspace {\r\n  min-width: 0;\r\n  padding: 30px clamp(24px, 4vw, 56px) 48px;\r\n  max-width: 1540px;\r\n}\r\n\r\n.topbar {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  align-items: flex-start;\r\n  margin-bottom: 22px;\r\n}\r\n\r\n.eyebrow {\r\n  margin: 0 0 6px;\r\n  text-transform: uppercase;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.08em;\r\n}\r\n\r\nh1,\r\nh2,\r\np {\r\n  margin: 0;\r\n}\r\n\r\nh1 {\r\n  font-size: clamp(34px, 4vw, 50px);\r\n  line-height: 0.98;\r\n}\r\n\r\nh2 {\r\n  font-size: 20px;\r\n  line-height: 1.15;\r\n}\r\n\r\n.session-pill,\r\n.notice,\r\nmark,\r\n.chips span {\r\n  border-radius: 999px;\r\n  padding: 7px 11px;\r\n  background: #eee7de;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n}\r\n\r\n.notice {\r\n  display: inline-flex;\r\n  margin-bottom: 18px;\r\n  white-space: normal;\r\n}\r\n\r\n.store-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) 300px;\r\n  gap: 24px;\r\n  align-items: start;\r\n}\r\n\r\n.catalog-panel {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.filters {\r\n  display: grid;\r\n  grid-template-columns: minmax(220px, 2fr) repeat(3, minmax(105px, 1fr)) auto;\r\n  gap: 8px;\r\n}\r\n\r\n.product-toolbar {\r\n  display: grid;\r\n  grid-template-columns: minmax(260px, 2fr) repeat(6, minmax(110px, 1fr)) auto auto;\r\n  gap: 8px;\r\n  align-items: stretch;\r\n}\r\n\r\n.search-field {\r\n  min-width: 0;\r\n}\r\n\r\n.catalog-summary {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  align-items: 