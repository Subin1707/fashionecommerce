: 1;\r\n  display: grid;\r\n  place-items: center;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  background: #eee7de;\r\n  color: #3b332b;\r\n  font-size: 28px;\r\n  user-select: none;\r\n}\r\n\r\n.category-admin-icon.large {\r\n  width: 68px;\r\n  height: 68px;\r\n  font-size: 32px;\r\n}\r\n\r\n.category-admin-card-body {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.category-admin-card-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: flex-start;\r\n}\r\n\r\n.category-admin-card-head h2,\r\n.category-admin-card-head p,\r\n.category-admin-card p {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.category-admin-card p {\r\n  line-height: 1.55;\r\n  font-size: 13.5px;\r\n}\r\n\r\n.category-admin-card-badges {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  align-items: center;\r\n}\r\n\r\n.category-admin-card-meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.category-admin-card-meta span {\r\n  border-radius: 999px;\r\n  padding: 6px 9px;\r\n  background: #eee7de;\r\n  font-size: 11.5px;\r\n  font-weight: 900;\r\n}\r\n\r\n.category-admin-actions,\r\n.category-admin-submit-row {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.category-admin-actions button,\r\n.category-admin-submit-row button {\r\n  min-height: 36px;\r\n}\r\n\r\n.category-admin-preview {\r\n  display: flex;\r\n  gap: 12px;\r\n  align-items: center;\r\n  padding: 12px;\r\n  border: 1px solid #eee7de;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n}\r\n\r\n.category-admin-preview strong,\r\n.category-admin-preview small {\r\n  display: block;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.category-admin-toggle {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  padding: 12px;\r\n  border: 1px solid #eee7de;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n  cursor: pointer;\r\n}\r\n\r\n.category-admin-toggle input {\r\n  width: 18px;\r\n  min-height: 18px;\r\n  accent-color: #3a5b56;\r\n  cursor: pointer;\r\n}\r\n\r\n.category-admin-empty-editor p:last-of-type {\r\n  line-height: 1.6;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .category-admin-kpi-grid {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n  .category-admin-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .category-admin-layout {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  .category-admin-toolbar {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n.catalog-category-pills {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  margin-bottom: 8px;\r\n  padding: 0 2px;\r\n}\r\n\r\n.category-pill-btn {\r\n  background: #f3eee6;\r\n  border: 1px solid #e5d9cc;\r\n  border-radius: 999px;\r\n  padding: 7px 16px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #554d43;\r\n  cursor: pointer;\r\n  transition: all 0.16s ease;\r\n  min-height: auto;\r\n}\r\n\r\n.category-pill-btn:hover {\r\n  background: #2a221a;\r\n  color: #ffffff;\r\n  border-color: #2a221a;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.category-pill-btn.active {\r\n  background: #9d533b;\r\n  color: #ffffff;\r\n  border-color: #9d533b;\r\n  box-shadow: 0 4px 10px rgba(157, 83, 59, 0.25);\r\n}\r\n\r\n/* =========================================================\r\n   DISCOUNT / VOUCHER MANAGEMENT (ADMIN)\r\n   ========================================================= */\r\n.discount-admin-page {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.discount-admin-hero,\r\n.discount-admin-toolbar,\r\n.discount-admin-list-panel,\r\n.discount-admin-editor-panel {\r\n  min-width: 0;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42, 34, 26, 0.07);\r\n}\r\n\r\n.discount-admin-hero {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 18px;\r\n  align-items: flex-start;\r\n  padding: 24px;\r\n}\r\n\r\n.discount-admin-hero p:last-child {\r\n  max-width: 720px;\r\n  margin-top: 8px;\r\n  color: #6f6860;\r\n  line-height: 1.65;\r\n}\r\n\r\n.discount-admin-hero button {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.discount-admin-kpi-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.discount-admin-kpi {\r\n  display: grid;\r\n  gap: 8px;\r\n  min-height: 104px;\r\n  padding: 16px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n}\r\n\r\n.discount-admin-kpi span,\r\n.discount-admin-ticket p,\r\n.discount-admin-meta span,\r\n.discount-admin-preview small,\r\n.discount-admin-empty-editor p {\r\n  color: #6f6860;\r\n}\r\n\r\n.discount-admin-kpi strong {\r\n  color: #1f1d1a;\r\n  font-size: clamp(24px, 2.5vw, 32px);\r\n  line-height: 1;\r\n}\r\n\r\n.discount-admin-kpi.success {\r\n  border-color: #a7cbb0;\r\n  background: #eef8f0;\r\n}\r\n\r\n.discount-admin-kpi.warning {\r\n  border-color: #e4c27c;\r\n  background: #fff7df;\r\n}\r\n\r\n.discount-admin-toolbar {\r\n  display: grid;\r\n  grid-template-columns: minmax(260px, 1fr) minmax(160px, 0.22fr) minmax(160px, 0.22fr) auto;\r\n  gap: 12px;\r\n  padding: 14px;\r\n}\r\n\r\n.discount-admin-layout {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(380px, 0.44fr);\r\n  gap: 18px;\r\n  align-items: start;\r\n}\r\n\r\n.discount-admin-list-panel,\r\n.discount-admin-editor-panel,\r\n.discount-admin-form,\r\n.discount-admin-empty-editor,\r\n.discount-admin-simulator {\r\n  display: grid;\r\n  gap: 14px;\r\n  padding: 16px;\r\n}\r\n\r\n.discount-admin-editor-panel {\r\n  position: sticky;\r\n  top: 24px;\r\n}\r\n\r\n.discount-admin-panel-heading {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n  align-items: flex-start;\r\n}\r\n\r\n.discount-admin-panel-heading .eyebrow {\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.discount-admin-tabs {\r\n  display: flex;\r\n  gap: 8px;\r\n  border-bottom: 1px solid #eee7de;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.discount-admin-tab-btn {\r\n  background: transparent;\r\n  border: 1px solid transparent;\r\n  border-radius: 6px;\r\n  padding: 8px 14px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  color: #6f6860;\r\n  cursor: pointer;\r\n  transition: all 0.15s ease;\r\n  min-height: auto;\r\n}\r\n\r\n.discount-admin-tab-btn:hover {\r\n  background: #eee7de;\r\n  color: #1f1d1a;\r\n}\r\n\r\n.discount-admin-tab-btn.active {\r\n  background: #2a221a;\r\n  color: #ffffff;\r\n}\r\n\r\n.discount-admin-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 14px;\r\n}\r\n\r\n/* Coupon Ticket Card */\r\n.discount-admin-ticket {\r\n  position: relative;\r\n  display: grid;\r\n  gap: 12px;\r\n  padding: 16px;\r\n  border: 1px solid #eee7de;\r\n  border-left: 5px solid #9d533b;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n  box-shadow: 0 4px 12px rgba(42, 34, 26, 0.04);\r\n  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;\r\n}\r\n\r\n.discount-admin-ticket:hover,\r\n.discount-admin-ticket.selected {\r\n  transform: translateY(-1px);\r\n  border-color: #9d533b;\r\n  box-shadow: 0 12px 24px rgba(157, 83, 59, 0.12);\r\n}\r\n\r\n.discount-admin-ticket.inactive {\r\n  border-left-color: #b0a89e;\r\n  opacity: 0.82;\r\n}\r\n\r\n.discount-admin-ticket.expired {\r\n  border-left-color: #c0392b;\r\n}\r\n\r\n.discount-admin-ticket-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  align-items: flex-start;\r\n}\r\n\r\n.discount-admin-code-wrap {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.discount-admin-code-pill {\r\n  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;\r\n  font-weight: 800;\r\n  font-size: 15px;\r\n  letter-spacing: 0.06em;\r\n  padding: 4px 10px;\r\n  background: #2a221a;\r\n  color: #fffdf9;\r\n  border-radius: 6px;\r\n  border: 1px solid #2a221a;\r\n  user-select: all;\r\n}\r\n\r\n.discount-admin-copy-btn {\r\n  background: transparent;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 6px;\r\n  padding: 3px 8px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: #6f6860;\r\n  cursor: pointer;\r\n  min-height: auto;\r\n}\r\n\r\n.discount-admin-copy-btn:hover {\r\n  background: #eee7de;\r\n  color: #1f1d1a;\r\n}\r\n\r\n.discount-admin-badge {\r\n  border-radius: 999px;\r\n  padding: 5px 10px;\r\n  font-size: 11.5px;\r\n  font-weight: 800;\r\n  white-space: nowrap;\r\n}\r\n\r\n.discount-admin-badge.active {\r\n  background: #e0f1e6;\r\n  color: #1e7042;\r\n}\r\n\r\n.discount-admin-badge.inactive {\r\n  background: #fff2cf;\r\n  color: #8a5b00;\r\n}\r\n\r\n.discount-admin-badge.expired {\r\n  background: #fde8e8;\r\n  color: #9b1c1c;\r\n}\r\n\r\n.discount-admin-ticket-value {\r\n  font-size: 18px;\r\n  font-weight: 800;\r\n  color: #1f1d1a;\r\n}\r\n\r\n.discount-admin-ticket-value span {\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: #6f6860;\r\n  margin-left: 6px;\r\n}\r\n\r\n.discount-admin-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  font-size: 12.5px;\r\n  color: #6f6860;\r\n  background: #f4ede2;\r\n  padding: 8px 12px;\r\n  border-radius: 6px;\r\n}\r\n\r\n.discount-admin-meta strong {\r\n  color: #3b332b;\r\n}\r\n\r\n.discount-admin-actions,\r\n.discount-admin-submit-row {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.discount-admin-actions button,\r\n.discount-admin-submit-row button {\r\n  min-height: 36px;\r\n}\r\n\r\n.discount-admin-preview {\r\n  position: relative;\r\n  display: grid;\r\n  gap: 10px;\r\n  padding: 16px;\r\n  border: 2px dashed #9d533b;\r\n  border-radius: 8px;\r\n  background: #fffbf8;\r\n}\r\n\r\n.discount-admin-preview-label {\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n  color: #9d533b;\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n.discount-admin-simulator-form {\r\n  display: grid;\r\n  gap: 12px;\r\n}\r\n\r\n.discount-simulator-result {\r\n  margin-top: 10px;\r\n  padding: 14px;\r\n  border-radius: 8px;\r\n  font-size: 13.5px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.discount-simulator-result.success {\r\n  background: #eef8f0;\r\n  border: 1px solid #a7cbb0;\r\n  color: #1e7042;\r\n}\r\n\r\n.discount-simulator-result.error {\r\n  background: #fdf2f2;\r\n  border: 1px solid #f8b4b4;\r\n  color: #9b1c1c;\r\n}\r\n\r\n.discount-simulator-result strong {\r\n  display: block;\r\n  font-size: 15px;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .discount-admin-kpi-grid {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n  .discount-admin-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .discount-admin-layout {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  .discount-admin-toolbar {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n.table-stack,\r\n.admin-space,\r\n.page-stack,\r\n.form-grid {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.home-band,\r\n.sub-nav {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n  padding: 22px 24px;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n}\r\n\r\n.home-band h2 {\r\n  max-width: 760px;\r\n  font-size: clamp(22px, 2.4vw, 32px);\r\n  line-height: 1.12;\r\n}\r\n\r\n.sub-nav {\r\n  flex-wrap: wrap;\r\n  justify-content: flex-start;\r\n}\r\n\r\n.row-actions {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.admin-section-heading {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.admin-section-heading .eyebrow { margin-bottom: 4px; }\r\n\r\n.admin-space > .sub-nav {\r\n  position: sticky;\r\n  top: 18px;\r\n  z-index: 5;\r\n  overflow-x: auto;\r\n  flex-wrap: nowrap;\r\n  p