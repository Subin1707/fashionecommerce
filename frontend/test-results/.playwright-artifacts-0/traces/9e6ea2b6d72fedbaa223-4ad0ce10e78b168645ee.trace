n    min-width: 0;\r\n    text-align: left;\r\n  }\r\n\r\n  .inventory-sku-actions {\r\n    justify-content: space-between;\r\n  }\r\n\r\n  .inventory-sku-price {\r\n    grid-column: auto;\r\n    margin-top: 0;\r\n  }\r\n\r\n  .order-admin-card-main {\r\n    grid-template-columns: 10px minmax(0, 1fr);\r\n  }\r\n\r\n  .order-admin-card-main b {\r\n    grid-column: 2;\r\n    min-width: 0;\r\n    text-align: left;\r\n  }\r\n\r\n  .order-admin-panel-heading > span,\r\n  .order-admin-status,\r\n  .order-admin-card-meta span {\r\n    align-self: flex-start;\r\n    white-space: normal;\r\n  }\r\n\r\n  .order-admin-danger-row {\r\n    justify-content: stretch;\r\n  }\r\n\r\n  .order-admin-detail-list div {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .order-admin-detail-list dd {\r\n    text-align: left;\r\n  }\r\n\r\n  .admin-product-wide-field {\r\n    grid-column: auto;\r\n  }\r\n\r\n  .wishlist-content-heading > span {\r\n    align-self: flex-start;\r\n    white-space: normal;\r\n  }\r\n\r\n  .profile-panel-heading,\r\n  .profile-actions {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n  }\r\n\r\n  .profile-panel-heading span,\r\n  .profile-actions button {\r\n    max-width: none;\r\n    width: 100%;\r\n  }\r\n\r\n  .session-pill {\r\n    white-space: normal;\r\n  }\r\n}\r\n\r\n.guest-layout {\r\n  min-height: 100svh;\r\n  background: #f2eee8;\r\n  color: #1d1a17;\r\n}\r\n\r\n.guest-header {\r\n  display: grid;\r\n  grid-template-columns: auto minmax(0, 1fr) auto;\r\n  align-items: center;\r\n  gap: 26px;\r\n  padding: 14px 28px 12px;\r\n  background: #e8e1d8;\r\n  border-bottom: 1px solid #d7cfc4;\r\n}\r\n\r\n.guest-brand {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  min-height: 44px;\r\n  padding: 10px 16px;\r\n  border: 0;\r\n  border-radius: 14px;\r\n  background: #1d1b1a;\r\n  color: #fff;\r\n  text-align: left;\r\n  white-space: nowrap;\r\n}\r\n\r\n.guest-brand-logo {\r\n  width: 24px;\r\n  height: 24px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 8px;\r\n  background: #f0d9ae;\r\n  color: #1d1b1a;\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n}\r\n\r\n.guest-brand-info {\r\n  display: grid;\r\n  gap: 2px;\r\n  line-height: 1;\r\n}\r\n\r\n.guest-brand-info strong {\r\n  font-size: 18px;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n.guest-brand-info small {\r\n  color: #d8c7a9;\r\n  font-size: 9px;\r\n  letter-spacing: 0.16em;\r\n}\r\n\r\n.guest-navigation {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.guest-navigation button {\r\n  min-height: 54px;\r\n  padding: 0 18px;\r\n  border-radius: 0;\r\n  background: transparent;\r\n  color: #2b2724;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  justify-content: flex-start;\r\n}\r\n\r\n.guest-navigation button.active {\r\n  background: #a45d3c;\r\n  color: #fff;\r\n  border-radius: 0;\r\n}\r\n\r\n.guest-header-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.guest-sign-in,\r\n.guest-sign-up {\r\n  min-height: 42px;\r\n  padding: 0 20px;\r\n  border-radius: 12px;\r\n  font-size: 15px;\r\n  font-weight: 700;\r\n}\r\n\r\n.guest-sign-in {\r\n  background: transparent;\r\n  color: #1d1a17;\r\n  border: 1px solid transparent;\r\n}\r\n\r\n.guest-sign-up {\r\n  background: #1d1a17;\r\n  color: #fff;\r\n}\r\n\r\n.guest-notice {\r\n  margin: 12px 20px 16px;\r\n  padding: 10px 14px;\r\n  border-radius: 12px;\r\n  background: rgba(157, 83, 59, 0.08);\r\n  color: #5a4338;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.guest-main {\r\n  padding: 0 0 24px;\r\n}\r\n\r\n.guest-footer {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding: 54px clamp(20px, 5vw, 76px) 20px;\r\n  border-top: 1px solid rgba(190, 112, 142, 0.24);\r\n  background:\r\n    radial-gradient(ellipse at 16% 0%, rgba(255, 209, 225, 0.54), transparent 38%),\r\n    linear-gradient(135deg, #fff4f7 0%, #ffedf3 52%, #fff5f0 100%);\r\n  color: #634253;\r\n}\r\n\r\n.guest-footer-main,\r\n.guest-footer-bottom {\r\n  position: relative;\r\n  z-index: 1;\r\n  width: min(100%, 1440px);\r\n  margin-inline: auto;\r\n}\r\n\r\n.guest-footer-main {\r\n  display: grid;\r\n  grid-template-columns: minmax(240px, 1.35fr) minmax(130px, 0.7fr) minmax(160px, 0.8fr) minmax(240px, 1.15fr);\r\n  gap: clamp(24px, 4vw, 64px);\r\n  padding-bottom: 44px;\r\n}\r\n\r\n.guest-footer-brand-lockup {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.guest-footer-mark {\r\n  display: grid;\r\n  width: 46px;\r\n  height: 46px;\r\n  place-items: center;\r\n  border: 1px solid rgba(173, 79, 114, 0.24);\r\n  border-radius: 16px;\r\n  background: linear-gradient(145deg, #fff, #f8dce7);\r\n  box-shadow: 0 8px 22px rgba(154, 75, 105, 0.13);\r\n  color: #a94368;\r\n  font-size: 22px;\r\n  font-weight: 850;\r\n}\r\n\r\n.guest-footer-brand-lockup strong {\r\n  display: block;\r\n  color: #512c3c;\r\n  font-size: 17px;\r\n  letter-spacing: 0.13em;\r\n}\r\n\r\n.guest-footer-brand-lockup small {\r\n  display: block;\r\n  margin-top: 4px;\r\n  color: #a56e83;\r\n  font-size: 9px;\r\n  font-weight: 750;\r\n  letter-spacing: 0.19em;\r\n}\r\n\r\n.guest-footer-brand > p,\r\n.guest-footer-cta > p {\r\n  max-width: 360px;\r\n  margin: 18px 0 0;\r\n  color: #806777;\r\n  font-size: 13px;\r\n  line-height: 1.8;\r\n}\r\n\r\n.guest-footer-tags {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 18px;\r\n}\r\n\r\n.guest-footer-tags span {\r\n  padding: 6px 10px;\r\n  border: 1px solid rgba(190, 112, 142, 0.18);\r\n  border-radius: 999px;\r\n  background: rgba(255, 255, 255, 0.58);\r\n  color: #95677b;\r\n  font-size: 11px;\r\n  font-weight: 650;\r\n}\r\n\r\n.guest-footer-links h2,\r\n.guest-footer-cta h2 {\r\n  margin: 4px 0 18px;\r\n  color: #512c3c;\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n}\r\n\r\n.guest-footer-links button {\r\n  display: block;\r\n  width: fit-content;\r\n  margin: 0 0 12px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: transparent;\r\n  color: #806777;\r\n  cursor: pointer;\r\n  font: inherit;\r\n  font-size: 13px;\r\n  text-align: left;\r\n  transition: color 160ms ease, transform 160ms ease;\r\n}\r\n\r\n.guest-footer-links button:hover {\r\n  transform: translateX(3px);\r\n  color: #a94368;\r\n}\r\n\r\n.guest-footer-note {\r\n  max-width: 220px;\r\n  margin: 16px 0 0;\r\n  color: #a18391;\r\n  font-size: 11px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.guest-footer-cta {\r\n  align-self: start;\r\n  padding: 22px;\r\n  border: 1px solid rgba(190, 112, 142, 0.22);\r\n  border-radius: 20px;\r\n  background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(250, 220, 232, 0.7));\r\n  box-shadow: 0 14px 34px rgba(152, 74, 103, 0.08);\r\n}\r\n\r\n.guest-footer-cta-label {\r\n  color: #b35b7b;\r\n  font-size: 9px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.18em;\r\n}\r\n\r\n.guest-footer-cta h2 {\r\n  margin: 10px 0 0;\r\n  font-size: 17px;\r\n  line-height: 1.45;\r\n}\r\n\r\n.guest-footer-cta > p {\r\n  margin-top: 8px;\r\n  font-size: 12px;\r\n}\r\n\r\n.guest-footer-cta button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  min-height: 40px;\r\n  margin-top: 18px;\r\n  padding: 0 15px;\r\n  border: 0;\r\n  border-radius: 12px;\r\n  background: linear-gradient(115deg, #a94368, #c96888);\r\n  box-shadow: 0 8px 18px rgba(169, 67, 104, 0.2);\r\n  color: #fff;\r\n  cursor: pointer;\r\n  font: inherit;\r\n  font-size: 12px;\r\n  font-weight: 750;\r\n  transition: transform 160ms ease, box-shadow 160ms ease;\r\n}\r\n\r\n.guest-footer-cta button:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 11px 22px rgba(169, 67, 104, 0.28);\r\n}\r\n\r\n.guest-footer-bottom {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  padding-top: 17px;\r\n  border-top: 1px solid rgba(190, 112, 142, 0.2);\r\n}\r\n\r\n.guest-footer-bottom p {\r\n  margin: 0;\r\n  color: #987e8b;\r\n  font-size: 11px;\r\n}\r\n\r\n.guest-footer-bottom button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding: 6px 0 6px 10px;\r\n  border: 0;\r\n  background: transparent;\r\n  color: #96647a;\r\n  cursor: pointer;\r\n  font: inherit;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n}\r\n\r\n.guest-footer-bottom button:hover {\r\n  color: #a94368;\r\n}\r\n\r\n@media (max-width: 1050px) {\r\n  .guest-footer-main {\r\n    grid-template-columns: minmax(220px, 1.2fr) minmax(130px, 0.7fr) minmax(160px, 0.8fr);\r\n  }\r\n\r\n  .guest-footer-cta {\r\n    grid-column: 1 / -1;\r\n  }\r\n}\r\n\r\n@media (max-width: 680px) {\r\n  .guest-footer {\r\n    padding: 38px 20px 18px;\r\n  }\r\n\r\n  .guest-footer-main {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 30px 22px;\r\n    padding-bottom: 32px;\r\n  }\r\n\r\n  .guest-footer-brand,\r\n  .guest-footer-cta {\r\n    grid-column: 1 / -1;\r\n  }\r\n\r\n  .guest-footer-cta {\r\n    padding: 20px;\r\n  }\r\n}\r\n\r\n@media (max-width: 420px) {\r\n  .guest-footer-main {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n\r\n  .guest-footer-brand,\r\n  .guest-footer-cta {\r\n    grid-column: auto;\r\n  }\r\n\r\n  .guest-footer-bottom {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n    gap: 8px;\r\n  }\r\n}\r\n\r\n/* Editorial auth experience */\r\n.auth-layout {\r\n  min-height: 100svh;\r\n  max-width: none;\r\n  display: grid;\r\n  grid-template-columns: minmax(420px, 1.08fr) minmax(480px, 0.92fr);\r\n  background: #120f0d;\r\n  color: #f4eee5;\r\n}\r\n\r\n.auth-layout button,\r\n.auth-layout input,\r\n.auth-layout textarea,\r\n.auth-layout .auth-card,\r\n.auth-layout .auth-tabs,\r\n.auth-layout .social-button {\r\n  border-radius: 0;\r\n}\r\n\r\n.auth-shell {\r\n  min-height: 100svh;\r\n  background: #120f0d;\r\n}\r\n\r\n.auth-showcase {\r\n  position: relative;\r\n  min-height: 100svh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  padding: 38px 44px 42px;\r\n  background: #083f45;\r\n  overflow: hidden;\r\n}\r\n\r\n.auth-showcase::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  background: linear-gradient(180deg, rgba(12, 11, 9, 0.18), rgba(12, 11, 9, 0.82));\r\n  pointer-events: none;\r\n}\r\n\r\n.auth-showcase::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: auto 8% 8% auto;\r\n  width: 240px;\r\n  height: 240px;\r\n  border-radius: 50%;\r\n  background: radial-gradient(circle, rgba(209, 170, 104, 0.38), rgba(209, 170, 104, 0) 68%);\r\n  opacity: 0.8;\r\n}\r\n\r\n.auth-showcase-image {\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.auth-showcase-header {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.auth-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  color: #f8f1e7;\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.16em;\r\n}\r\n\r\n.auth-brand span {\r\n  display: inline-grid;\r\n  place-items: center;\r\n  width: 28px;\r\n  height: 28px;\r\n  border-radius: 10px;\r\n  background: rgba(209, 170, 104, 0.18);\r\n  color: #d7b772;\r\n  font-size: 18px;\r\n}\r\n\r\n.auth-badge {\r\n  padding: 8px 12px;\r\n  border: 1px solid rgba(255, 255, 255, 0.18);\r\n  border-radius: 999px;\r\n  background: rgba(255, 255, 255, 0.04);\r\n  color: #ebd9b5;\r\n  font-size: 10px;\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.auth-showcase-copy {\r\n  position: relative;\r\n  z-index: 1;\r\n  max-width: 470px;\r\n}\r\n\r\n.auth-showcase-copy p {\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: clamp(32px, 3vw, 52px);\r\n  line-height: 1.08;\r\n  color: #f9f3ee;\r\n}\r\n\r\n.auth-showcase-copy em,\r\n.auth-card h1 em {\r\n  color: #d4ad6a;\r\n}\r\n\r\n.auth-showcase-copy small {\r\n  display: block;\r\n  max-width: 410px;\r\n  margin-top: 18px;\r\n  color: #d5c9bb;\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.auth-promises {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 18px 24px;\r\n  margin-top: 30px;\r\n  color: #f0d7a1;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.1em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.auth-promises span::before {\r\n  content: \"•\";\r\n  margin-right: 8px;\r\n  color: #f0d7a1;\r\n}\r\n\r\n.auth-showcase-footer {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 18px;\r\n}\r\n\r\n.mini-stat {\r\n  display: grid;\r\n  gap: 4px;\r\n  min-width: 170px;\r\n  padding: 14px 16px;\r\n  border: 1px solid rgba(255, 255, 255, 0.12);\r\n  border-radius: 16px;\r\n  background: rgba(17, 14, 11, 0.26);\r\n}\r\n\r\n.mini-stat strong {\r\n  color: #f4ddaf;\r\n  font-size: 20px;\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n}\r\n\r\n.mini-stat span {\r\n  color: #d5c9bb;\r\n  font-size: 11px;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.auth-card-wrap {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 40px clamp(22px, 5vw, 80px);\r\n  background: linear-gradient(180deg, rgba(17, 15, 13, 0.94), rgba(17, 15, 13, 0.98));\r\n}\r\n\r\n.auth-card {\r\n  width: min(100%, 590px);\r\n  padding: 28px clamp(18px, 3vw, 48px) 22px;\r\n  border: 1px solid rgba(139, 122, 102, 0.32);\r\n  border-radius: 26px;\r\n  background: rgba(19, 17, 14, 0.82);\r\n  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.22);\r\n}\r\n\r\n.auth-kicker {\r\n  margin-bottom: 12px;\r\n  color: #9b8875;\r\n  font-size: 11px;\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.auth-card h1 {\r\n  margin: 0;\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: clamp(34px, 3vw, 48px);\r\n  line-height: 1.02;\r\n  font-weight: 600;\r\n  color: #f6efe8;\r\n}\r\n\r\n.auth-subtitle {\r\n  margin-top: 14px;\r\n  color: #8d847c;\r\n  font-size: 13px;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.auth-tabs {\r\n  margin: 32px 0 28px;\r\n  display: flex;\r\n  gap: 24px;\r\n  padding: 0;\r\n  border-bottom: 1px solid #2d2722;\r\n  background: transparent;\r\n}\r\n\r\n.auth-tabs button {\r\n  position: relative;\r\n  min-height: 44px;\r\n  padding: 0 0 14px;\r\n  border-radius: 0;\r\n  color: #756d65;\r\n  background: transparent;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.auth-tabs button.active,\r\n.auth-tabs button:hover {\r\n  color: #f5eee5;\r\n  background: transparent;\r\n}\r\n\r\n.auth-tabs button.active::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  bottom: -1px;\r\n  left: 0;\r\n  right: 0;\r\n  height: 2px;\r\n  background: #d1aa68;\r\n}\r\n\r\n.auth-form {\r\n  gap: 22px;\r\n}\r\n\r\n.auth-form label {\r\n  color: #9f958b;\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.auth-form input,\r\n.auth-form textarea {\r\n  min-height: 42px;\r\n  padding: 10px 0;\r\n  border: 0;\r\n  border-bottom: 1px solid #3a342d;\r\n  border-radius: 0;\r\n  outline: 0;\r\n  background: transparent;\r\n  color: #f5eee5;\r\n  font-size: 14px;\r\n  letter-spacing: 0;\r\n}\r\n\r\n.auth-form textarea { min-height: 58px; }\r\n.auth-form input::placeholder { color: #514b45; }\r\n.auth-form input:focus, .auth-form textarea:focus { border-color: #d1aa68; box-shadow: none; }\r\n.auth-form label:focus-within { color: #d1aa68; }\r\n.auth-form input:-webkit-autofill,\r\n.auth-form input:-webkit-autofill:hover,\r\n.auth-form input:-webkit-autofill:focus {\r\n  -webkit-text-fill-color: #f5eee5;\r\n  -webkit-box-shadow: 0 0 0 1000px #120f0d inset;\r\n  box-shadow: 0 0 0 1000px #120f0d inset;\r\n  caret-color: #f5eee5;\r\n  transition: background-color 9999s ease-out;\r\n}\r\n\r\n.auth-form .checkbox-label input {\r\n  width: 14px;\r\n  height: 14px;\r\n  min-height: 14px;\r\n  padding: 0;\r\n  border: 1px solid #665b4c;\r\n  background: #120f0d;\r\n  accent-color: #d1aa68;\r\n}\r\n\r\n.auth-form input, .auth-form textarea, .auth-tabs button, .text-button, .social-button, .auth-actions button {\r\n  transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, opacity 180ms ease;\r\n}\r\n\r\n.password-field { position: relative; display: block; }\r\n.password-field input { padding-right: 46px; }\r\n.password-toggle {\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 5px;\r\n  min-height: 24px;\r\n  padding: 0;\r\n  color: #8d8174;\r\n  background: transparent;\r\n  font-size: 10px;\r\n  text-transform: uppercase;\r\n}\r\n.password-toggle:hover { color: #d1aa68; background: transparent; }\r\n\r\n.auth-options {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 12px;\r\n  margin-top: -6px;\r\n}\r\n\r\n.checkbox-label {\r\n  display: flex !important;\r\n  align-items: center;\r\n  gap: 8px;\r\n  color: #756d65 !important;\r\n  letter-spacing: 0 !important;\r\n  text-transform: none !important;\r\n}\r\n\r\n.checkbox-label input { width: 14px; min-height: 14px; accent-color: #d1aa68; }\r\n.text-button {\r\n  min-height: auto;\r\n  padding: 0;\r\n  color: #b9965c;\r\n  background: transparent;\r\n  font-size: 11px;\r\n}\r\n.text-button:hover { color: #ebc981; background: transparent; }\r\n\r\n.auth-actions { grid-template-columns: 1fr; }\r\n.auth-actions button[type=\"submit\"] {\r\n  min-height: 48px;\r\n  border-radius: 12px;\r\n  color: #17120d;\r\n  background: linear-gradient(135deg, #e4c375, #d1aa68);\r\n  box-shadow: 0 10px 18px rgba(209, 170, 104, 0.3);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.16em;\r\n  text-transform: uppercase;\r\n}\r\n.auth-actions button[type=\"submit\"]:hover { background: linear-gradient(135deg, #f1d79d, #ddbb72); }\r\n.auth-actions button:disabled { opacity: 0.6; cursor: wait; }\r\n\r\n.auth-divider { display: flex; align-items: center; gap: 14px; color: #615950; font-size: 10px; text-transform: uppercase; }\r\n.auth-divider::before, .auth-divider::after { content: \"\"; height: 1px; flex: 1; background: #2b2621; }\r\n.social-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\r\n.social-button { min-height: 42px; border: 1px solid #352f29; border-radius: 10px; color: #b2a69a; background: transparent; font-size: 12px; }\r\n.social-button:hover { border-color: #80643d; background: #1a1612; }\r\n.social-button b { margin-right: 8px; color: #d1aa68; font-size: 16px; }\r\n.auth-register-hint { padding-top: 24px; border-top: 1px solid #2c2722; color: #685f57; font-size: 11px; }\r\n.auth-legal { margin-top: 30px; color: #564e47; font-size: 10px; line-height: 1.6; }\r\n.register-form .auth-actions { margin-top: 4px; }\r\n\r\n@media (max-width: 900px) {\r\n  .auth-layout { grid-template-columns: 1fr; }\r\n  .auth-showcase { min-height: 320px; }\r\n  .auth-showcase-copy { max-width: 100%; }\r\n  .auth-showcase-copy small { max-width: 100%; }\r\n  .auth-card-wrap { padding-top: 20px; }\r\n}\r\n\r\n@media (max-width: 800px) {\r\n  .auth-showcase { padding: 26px 24px; }\r\n  .auth-showcase-image { display: none; }\r\n  .auth-showcase-copy { display: none; }\r\n  .auth-showcase-footer { display: none; }\r\n  .auth-card { width: 100%; border-radius: 20px; }\r\n  .auth-card-wrap { padding: 18px 14px 20px; }\r\n}\r\n\r\n@keyframes auth-card-enter {\r\n  from { opacity: 0; transform: translateY(12px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .auth-card { animation: none; }\r\n  .auth-form input, .auth-form textarea, .auth-tabs button, .text-button, .social-button, .auth-actions button { transition: none; }\r\n}\r\n\r\n/* Soft pink storefront canvas with a slow ambient glow behind the content. */\r\n.app-shell,\r\n.guest-layout,\r\n.auth-shell {\r\n  background: transparent;\r\n}\r\n\r\n.side-nav {\r\n  border-right-color: rgba(221, 190, 199, 0.72);\r\n  background: rgba(255, 249, 251, 0.88);\r\n}\r\n\r\n.guest-header {\r\n  border-bottom-color: rgba(221, 190, 199, 0.72);\r\n  background: rgba(255, 239, 245, 0.88);\r\n}\r\n\r\n/* =========================================================\r\n   REVIEW MANAGEMENT (ADMIN)\r\n   ========================================================= */\r\n.review-admin-page {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n/* Hero */\r\n.review-admin-hero {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n  align-items: flex-start;\r\n  padding: 24px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42,34,26,0.07);\r\n}\r\n\r\n.review-admin-hero h1 { margin: 6px 0 0; }\r\n.review-admin-hero p:last-child {\r\n  max-width: 620px;\r\n  margin-top: 8px;\r\n  color: #6f6860;\r\n  line-height: 1.65;\r\n}\r\n\r\n.review-admin-hero-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.review-admin-product-form {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n.review-admin-product-form input {\r\n  min-height: 36px;\r\n  width: 170px;\r\n  padding: 6px 10px;\r\n  font-size: 13px;\r\n}\r\n.review-admin-product-form button { min-height: 36px; }\r\n\r\n/* KPI Grid */\r\n.review-admin-kpi-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(5, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.review-admin-kpi {\r\n  display: grid;\r\n  gap: 8px;\r\n  min-height: 100px;\r\n  padding: 16px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 4px 12px rgba(42,34,26,0.05);\r\n  transition: box-shadow 180ms;\r\n}\r\n.review-admin-kpi:hover { box-shadow: 0 8px 24px rgba(42,34,26,0.1); }\r\n.review-admin-kpi span { font-size: 12px; color: #8d7f72; text-transform: uppercase; letter-spacing: 0.06em; }\r\n.review-admin-kpi strong { font-size: 28px; font-weight: 800; color: #2a221a; }\r\n.review-admin-kpi strong em { font-style: normal; color: #d4a84b; margin-right: 2px; }\r\n.review-admin-kpi.warning { border-color: #e9c26b; background: #fdf8ee; }\r\n.review-admin-kpi.warning strong { color: #8a6620; }\r\n.review-admin-kpi.success { border-color: #7cc49a; background: #f0faf4; }\r\n.review-admin-kpi.success strong { color: #1e7042; }\r\n.review-admin-kpi.danger { border-color: #e4a8a0; background: #fdf3f2; }\r\n.review-admin-kpi.danger strong { color: #9d3b30; }\r\n\r\n/* Toolbar */\r\n.review-admin-toolbar {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  padding: 14px 16px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n}\r\n.review-admin-toolbar input { flex: 1 1 220px; min-height: 36px; padding: 6px 10px; }\r\n.review-admin-toolbar select { min-height: 36px; padding: 6px 10px; }\r\n.review-admin-toolbar button { flex: 0 0 auto; min-height: 36px; }\r\n\r\n/* Layout */\r\n.review-admin-layout {\r\n  display: grid;\r\n  grid-template-columns: 1fr 380px;\r\n  gap: 16px;\r\n  align-items: start;\r\n}\r\n\r\n/* Panels */\r\n.review-admin-list-panel,\r\n.review-admin-detail-panel {\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42,34,26,0.07);\r\n  overflow: hidden;\r\n}\r\n\r\n.review-admin-panel-heading {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  padding: 18px 20px 16px;\r\n  border-bottom: 1px solid #ede6db;\r\n}\r\n.review-admin-panel-heading h2 { margin: 4px 0 0; font-size: 18px; }\r\n\r\n.review-admin-pending-badge {\r\n  display: inline-block;\r\n  padding: 4px 10px;\r\n  border-radius: 20px;\r\n  background: #fdf3e0;\r\n  border: 1px solid #e9c26b;\r\n  color: #7c5a10;\r\n  font-size: 11.5px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Review list */\r\n.review-admin-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n  max-height: 70vh;\r\n  overflow-y: auto;\r\n}\r\n\r\n/* Review card */\r\n.review-admin-card {\r\n  padding: 14px 20px;\r\n  border-bottom: 1px solid #ede6db;\r\n  cursor: pointer;\r\n  transition: background 160ms;\r\n  outline: none;\r\n}\r\n.review-admin-card:last-child { border-bottom: none; }\r\n.review-admin-card:hover { background: #faf5ee; }\r\n.review-admin-card.selected { background: #f0eae1; border-left: 3px solid #3a5b56; }\r\n.review-admin-card.warning { border-left: 3px solid #d4a84b; }\r\n.review-admin-card.danger { border-left: 3px solid #c0392b; }\r\n\r\n.review-admin-card-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.review-admin-card-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.review-admin-stars { color: #d4a84b; font-size: 13px; letter-spacing: 1px; }\r\n.review-admin-stars.large { font-size: 20px; }\r\n.review-admin-date { font-size: 11.5px; color: #9d8e82; }\r\n\r\n.review-admin-status-badge {\r\n  display: inline-block;\r\n  padding: 3px 9px;\r\n  border-radius: 20px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n  background: #f0ece6;\r\n  color: #6f6860;\r\n  border: 1px solid #d7cec3;\r\n}\r\n.review-admin-status-badge.warning { background: #fdf8ee; border-color: #e9c26b; color: #7c5a10; }\r\n.review-admin-status-badge.success { background: #f0faf4; border-color: #7cc49a; color: #1e7042; }\r\n.review-admin-status-badge.danger  { background: #fdf3f2; border-color: #e4a8a0; color: #9d3b30; }\r\n.review-admin-status-badge.large { padding: 6px 14px; font-size: 13px; }\r\n\r\n.review-admin-comment {\r\n  margin: 0 0 8px;\r\n  font-size: 13.5px;\r\n  color: #3d342c;\r\n  line-height: 1.55;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.review-admin-card-footer {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  font-size: 12px;\r\n  color: #9d8e82;\r\n}\r\n\r\n.review-admin-card-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n  margin-left: auto;\r\n}\r\n.review-admin-card-actions button {\r\n  min-height: 28px;\r\n  padding: 0 8px;\r\n  font-size: 12px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.success-btn {\r\n  background: #1e7042;\r\n  color: #fff;\r\n  border: none;\r\n}\r\n.success-btn:hover { background: #155c33; }\r\n.danger-outline {\r\n  background: transparent;\r\n  color: #9d3b30;\r\n  border: 1px solid #e4a8a0;\r\n}\r\n.danger-outline:hover { background: #fdf3f2; }\r\n\r\n/* Detail panel */\r\n.review-admin-empty-detail {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  text-align: center;\r\n  gap: 10px;\r\n  padding: 40px 24px;\r\n}\r\n.review-admin-empty-icon { font-size: 42px; opacity: 0.55; }\r\n.review-admin-empty-detail h2 { margin: 0; font-size: 18px; }\r\n.review-admin-empty-detail p { color: #6f6860; font-size: 13.5px; line-height: 1.65; max-width: 280px; }\r\n\r\n.review-admin-detail { display: grid; gap: 0; }\r\n.review-admin-detail-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n  padding: 20px;\r\n  border-bottom: 1px solid #ede6db;\r\n}\r\n\r\n.review-admin-detail-status { }\r\n.review-admin-detail-rating {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n.review-admin-rating-num { font-size: 14px; color: #6f6860; }\r\n\r\n.review-admin-detail-comment blockquote {\r\n  margin: 8px 0 0;\r\n  padding: 12px 16px;\r\n  border-left: 3px solid #d7cec3;\r\n  background: #f7f3ee;\r\n  border-radius: 0 6px 6px 0;\r\n  font-size: 14px;\r\n  color: #3d342c;\r\n  line-height: 1.65;\r\n}\r\n\r\n.review-admin-detail-info {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n.review-admin-detail-info > div {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 13px;\r\n  padding-bottom: 8px;\r\n  border-bottom: 1px solid #f0ece6;\r\n}\r\n.review-admin-detail-info > div:last-child { border-bottom: none; padding-bottom: 0; }\r\n.review-admin-detail-info span { color: #9d8e82; }\r\n.review-admin-detail-info strong { color: #2a221a; }\r\n.review-admin-detail-info strong.success { color: #1e7042; }\r\n.review-admin-detail-info strong.warning { color: #7c5a10; }\r\n.review-admin-detail-info strong.danger  { color: #9d3b30; }\r\n\r\n.review-admin-detail-actions {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 16px 20px;\r\n}\r\n.review-admin-detail-actions button { width: 100%; min-height: 38px; }\r\n\r\n@media (max-width: 1100px) {\r\n  .review-admin-layout { grid-template-columns: 1fr; }\r\n  .review-admin-kpi-grid { grid-template-columns: repeat(3, 1fr); }\r\n}\r\n@media (max-width: 680px) {\r\n  .review-admin-kpi-grid { grid-template-columns: repeat(2, 1fr); }\r\n  .review-admin-hero { flex-direction: column; }\r\n}\r\n\r\n/* ==========================================================================\r\n   REPORT & BUSINESS INTELLIGENCE PAGE STYLES\r\n   ========================================================================== */\r\n\r\n.report-page {\r\n  display: grid;\r\n  gap: 22px;\r\n  animation: fadeInReport 0.3s ease-out;\r\n}\r\n\r\n@keyframes fadeInReport {\r\n  from { opacity: 0; transform: translateY(6px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n/* Hero Header */\r\n.report-hero {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-end;\r\n  flex-wrap: wrap;\r\n  gap: 20px;\r\n  padding: 30px;\r\n  border: 1px solid #dcd4c9;\r\n  border-radius: 12px;\r\n  background: linear-gradient(135deg, #1d1b18 0%, #2f2a24 50%, #222926 100%);\r\n  color: #fffdf9;\r\n  box-shadow: 0 16px 36px rgba(29, 27, 24, 0.12);\r\n}\r\n\r\n.report-hero-content {\r\n  max-width: 680px;\r\n}\r\n\r\n.report-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 4px 12px;\r\n  margin-bottom: 12px;\r\n  border-radius: 20px;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  border: 1px solid rgba(255, 255, 255, 0.15);\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.8px;\r\n  color: #d7b57b;\r\n}\r\n\r\n.live-dot {\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: #10b981;\r\n  box-shadow: 0 0 8px #10b981;\r\n  animation: pulseDot 2s infinite;\r\n}\r\n\r\n@keyframes pulseDot {\r\n  0%, 100% { opacity: 1; transform: scale(1); }\r\n  50% { opacity: 0.4; transform: scale(0.85); }\r\n}\r\n\r\n.report-hero-content h1 {\r\n  font-size: clamp(24px, 2.6vw, 34px);\r\n  font-weight: 800;\r\n  margin-bottom: 8px;\r\n  letter-spacing: -0.5px;\r\n}\r\n\r\n.report-hero-content p {\r\n  color: #c5bcb2;\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.report-hero-controls {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-end;\r\n  gap: 12px;\r\n}\r\n\r\n.report-range-selector {\r\n  display: flex;\r\n  background: rgba(255, 255, 255, 0.08);\r\n  padding: 4px;\r\n  border-radius: 8px;\r\n  border: 1px solid rgba(255, 255, 255, 0.12);\r\n}\r\n\r\n.report-range-btn {\r\n  padding: 6px 14px;\r\n  border: none;\r\n  background: transparent;\r\n  color: #d9d1c7;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  transition: all 0.15s ease;\r\n}\r\n\r\n.report-range-btn:hover {\r\n  color: #fff;\r\n}\r\n\r\n.report-range-btn.active {\r\n  background: #fff;\r\n  color: #1d1b18;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.report-action-buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n.report-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 8px 16px;\r\n  border-radius: 8px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.15s ease;\r\n  border: 1px solid transparent;\r\n}\r\n\r\n.report-btn.primary {\r\n  background: #d1aa68;\r\n  color: #1d1b18;\r\n  border-color: #d1aa68;\r\n}\r\n\r\n.report-btn.primary:hover {\r\n  background: #e2be7f;\r\n}\r\n\r\n.report-btn.secondary {\r\n  background: rgba(255, 255, 255, 0.1);\r\n  color: #fff;\r\n  border-color: rgba(255, 255, 255, 0.18);\r\n}\r\n\r\n.report-btn.secondary:hover {\r\n  background: rgba(255, 255, 255, 0.18);\r\n}\r\n\r\n/* KPI Cards */\r\n.report-kpi-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, 1fr);\r\n  gap: 14px;\r\n}\r\n\r\n.report-kpi-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  padding: 18px 20px;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 10px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 4px 16px rgba(42, 34, 26, 0.04);\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\n.report-kpi-card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 8px 22px rgba(42, 34, 26, 0.08);\r\n}\r\n\r\n.report-kpi-card.highlight {\r\n  border-color: #d7b57b;\r\n  background: linear-gradient(180deg, #fffdf9 0%, #faf5ec 100%);\r\n}\r\n\r\n.report-kpi-card.warning {\r\n  border-color: #f3c294;\r\n}\r\n\r\n.kpi-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 13px;\r\n  color: #6f6860;\r\n  font-weight: 600;\r\n}\r\n\r\n.kpi-icon {\r\n  font-size: 18px;\r\n}\r\n\r\n.kpi-value {\r\n  font-size: clamp(20px, 1.8vw, 26px);\r\n  font-weight: 800;\r\n  color: #1d1b18;\r\n  margin: 10px 0 6px;\r\n  letter-spacing: -0.4px;\r\n}\r\n\r\n.kpi-footer {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  font-size: 12px;\r\n  color: #8b8177;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.kpi-tag {\r\n  display: inline-block;\r\n  font-weight: 600;\r\n  font-size: 11px;\r\n}\r\n\r\n.kpi-tag.positive {\r\n  color: #0d8a54;\r\n}\r\n\r\n.kpi-tag.alert {\r\n  color: #c53030;\r\n}\r\n\r\n/* Tabs Navigation */\r\n.report-tabs-nav {\r\n  display: flex;\r\n  gap: 8px;\r\n  border-bottom: 2px solid #ddd5cb;\r\n  padding-bottom: 0;\r\n  overflow-x: auto;\r\n}\r\n\r\n.report-tab-btn {\r\n  padding: 12px 20px;\r\n  border: none;\r\n  background: transparent;\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  color: #6f6860;\r\n  cursor: pointer;\r\n  border-bottom: 3px solid transparent;\r\n  margin-bottom: -2px;\r\n  transition: all 0.15s ease;\r\n  white-space: nowrap;\r\n}\r\n\r\n.report-tab-btn:hover {\r\n  color: #1d1b18;\r\n}\r\n\r\n.report-tab-btn.active {\r\n  color: #1d1b18;\r\n  border-bottom-color: #1d1b18;\r\n}\r\n\r\n/* Tab Content & Cards */\r\n.report-tab-content {\r\n  display: grid;\r\n  gap: 20px;\r\n}\r\n\r\n.report-card {\r\n  padding: 24px;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 10px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 4px 18px rgba(42, 34, 26, 0.04);\r\n}\r\n\r\n.report-card-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 20px;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n}\r\n\r\n.report-card-head h3 {\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n  margin: 2px 0 0 0;\r\n}\r\n\r\n.report-metric-toggle {\r\n  display: flex;\r\n  border: 1px solid #d5cbbf;\r\n  border-radius: 6px;\r\n  overflow: hidden;\r\n}\r\n\r\n.report-metric-toggle button {\r\n  padding: 6px 14px;\r\n  border: none;\r\n  background: #fbf8f3;\r\n  color: #6f6860;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.15s ease;\r\n}\r\n\r\n.report-metric-toggle button.active {\r\n  background: #1d1b18;\r\n  color: #fff;\r\n}\r\n\r\n/* SVG Bar Chart */\r\n.report-svg-chart-container {\r\n  position: relative;\r\n  min-height: 240px;\r\n  padding: 10px 0;\r\n}\r\n\r\n.report-chart-canvas {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  height: 200px;\r\n  border-bottom: 1px solid #dcd4c9;\r\n  padding-bottom: 4px;\r\n}\r\n\r\n.chart-bar-col {\r\n  flex: 1;\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  cursor: pointer;\r\n  transition: transform 0.15s ease;\r\n}\r\n\r\n.chart-bar-col:hover {\r\n  transform: translateY(-3px);\r\n}\r\n\r\n.bar-wrapper {\r\n  width: 100%;\r\n  max-width: 44px;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: center;\r\n}\r\n\r\n.bar-fill {\r\n  width: 100%;\r\n  background: linear-gradient(180deg, #d1aa68 0%, #8e682e 100%);\r\n  border-radius: 5px 5px 0 0;\r\n  transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.15s ease;\r\n}\r\n\r\n.chart-bar-col.hovered .bar-fill {\r\n  background: linear-gradient(180deg, #1d1b18 0%, #3e3831 100%);\r\n  filter: brightness(1.1);\r\n}\r\n\r\n.bar-label {\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  color: #8b8177;\r\n  margin-top: 8px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.report-chart-tooltip {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 16px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 10px 16px;\r\n  background: #1d1b18;\r\n  color: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);\r\n  font-size: 13px;\r\n  z-index: 10;\r\n  animation: fadeInTooltip 0.15s ease-out;\r\n}\r\n\r\n@keyframes fadeInTooltip {\r\n  from { opacity: 0; transform: translateY(-4px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.report-chart-tooltip strong {\r\n  color: #d1aa68;\r\n}\r\n\r\n.chart-legend-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 14px;\r\n  font-size: 12px;\r\n  color: #8b8177;\r\n}\r\n\r\n.legend-item {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.legend-item .dot.revenue {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 2px;\r\n  background: #d1aa68;\r\n}\r\n\r\n/* Grids */\r\n.report-grid-2 {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 20px;\r\n}\r\n\r\n.report-grid-3 {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 16px;\r\n}\r\n\r\n/* Payment Share */\r\n.payment-share-list {\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n\r\n.payment-share-row {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.share-info {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 13px;\r\n}\r\n\r\n.share-bar-track {\r\n  height: 8px;\r\n  background: #ede6dc;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n}\r\n\r\n.share-bar-fill {\r\n  height: 100%;\r\n  background: #1d1b18;\r\n  border-radius: 4px;\r\n  transition: width 0.4s ease;\r\n}\r\n\r\n/* Catalog Summary Block */\r\n.catalog-summary-block {\r\n  display: grid;\r\n  gap: 16px;\r\n}\r\n\r\n.stat-big span {\r\n  display: block;\r\n  font-size: 13px;\r\n  color: #6f6860;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.stat-big strong {\r\n  font-size: 26px;\r\n  color: #1d1b18;\r\n  font-weight: 800;\r\n}\r\n\r\n.stat-pills {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.pill {\r\n  padding: 6px 12px;\r\n  border-radius: 20px;\r\n  background: #f4eee5;\r\n  color: #4a423a;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.summary-desc {\r\n  font-size: 12px;\r\n  color: #8b8177;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* Status Funnel Grid */\r\n.status-funnel-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, 1fr);\r\n  gap: 12px;\r\n}\r\n\r\n.status-funnel-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 16px;\r\n  border-radius: 8px;\r\n  border: 1px solid #ddd5cb;\r\n  background: #fbf8f3;\r\n  gap: 6px;\r\n}\r\n\r\n.status-funnel-card.green  { border-top: 4px solid #10b981; }\r\n.status-funnel-card.teal   { border-top: 4px solid #0d9488; }\r\n.status-funnel-card.blue   { border-top: 4px solid #3b82f6; }\r\n.status-funnel-card.amber  { border-top: 4px solid #f59e0b; }\r\n.status-funnel-card.orange { border-top: 4px solid #f97316; }\r\n.status-funnel-card.red    { border-top: 4px solid #ef4444; }\r\n\r\n.funnel-label {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #6f6860;\r\n}\r\n\r\n.funnel-count {\r\n  font-size: 22px;\r\n  font-weight: 800;\r\n  color: #1d1b18;\r\n}\r\n\r\n.funnel-meter {\r\n  height: 5px;\r\n  background: #e5ddd1;\r\n  border-radius: 3px;\r\n  overflow: hidden;\r\n  margin: 4px 0;\r\n}\r\n\r\n.funnel-meter-fill {\r\n  height: 100%;\r\n  background: #1d1b18;\r\n}\r\n\r\n.status-funnel-card small {\r\n  font-size: 11px;\r\n  color: #8b8177;\r\n}\r\n\r\n/* Tables */\r\n.report-table-wrapper {\r\n  overflow-x: auto;\r\n}\r\n\r\n.report-data-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  font-size: 13px;\r\n}\r\n\r\n.report-data-table th {\r\n  text-align: left;\r\n  padding: 12px 14px;\r\n  border-bottom: 2px solid #ddd5cb;\r\n  color: #6f6860;\r\n  font-weight: 700;\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n}\r\n\r\n.report-data-table td {\r\n  padding: 14px;\r\n  border-bottom: 1px solid #eee7de;\r\n  color: #201f1d;\r\n}\r\n\r\n.report-data-table tr:hover td {\r\n  background: #fbf8f3;\r\n}\r\n\r\n.text-center { text-align: center; }\r\n.text-right { text-align: right; }\r\n.font-weight-bold { font-weight: 700; }\r\n\r\n.status-tag {\r\n  display: inline-block;\r\n  padding: 4px 10px;\r\n  border-radius: 12px;\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n}\r\n\r\n.status-tag.green { background: #e0f2e9; color: #0d8a54; }\r\n.status-tag.teal  { background: #e0f4f2; color: #0f766e; }\r\n.status-tag.blue  { background: #e0edfd; color: #1d4ed8; }\r\n.status-tag.amber { background: #fef3c7; color: #b45309; }\r\n.status-tag.orange{ background: #ffedd5; color: #c2410c; }\r\n.status-tag.red   { background: #fee2e2; color: #b91c1c; }\r\n.status-tag.neutral { background: #f3eee7; color: #6b635b; }\r\n\r\n.share-pill {\r\n  padding: 3px 8px;\r\n  background: #f0ece5;\r\n  border-radius: 10px;\r\n  font-weight: 600;\r\n  font-size: 11px;\r\n}\r\n\r\n.prod-cell {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.prod-thumb {\r\n  width: 44px;\r\n  height: 44px;\r\n  object-fit: cover;\r\n  border-radius: 6px;\r\n  border: 1px solid #ddd5cb;\r\n}\r\n\r\n.prod-thumb-empty {\r\n  width: 44px;\r\n  height: 44px;\r\n  background: #eee7de;\r\n  border-radius: 6px;\r\n}\r\n\r\n/* Inventory Health */\r\n.inventory-health-card {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  border: 1px solid #ddd5cb;\r\n  background: #fffdf9;\r\n}\r\n\r\n.inventory-health-card.good   { border-left: 5px solid #10b981; }\r\n.inventory-health-card.warn   { border-left: 5px solid #f59e0b; }\r\n.inventory-health-card.danger { border-left: 5px solid #ef4444; }\r\n\r\n.health-icon {\r\n  font-size: 28px;\r\n}\r\n\r\n.inventory-health-card strong {\r\n  display: block;\r\n  font-size: 20px;\r\n  color: #1d1b18;\r\n}\r\n\r\n.inventory-health-card span {\r\n  font-size: 12px;\r\n  color: #6f6860;\r\n}\r\n\r\n.stock-badge {\r\n  display: inline-block;\r\n  padding: 4px 10px;\r\n  border-radius: 12px;\r\n  font-weight: 700;\r\n  font-size: 12px;\r\n}\r\n\r\n.stock-badge.zero { background: #fee2e2; color: #b91c1c; }\r\n.stock-badge.low  { background: #fef3c7; color: #b45309; }\r\n\r\n.badge-pill {\r\n  padding: 4px 12px;\r\n  background: #f4eee5;\r\n  border-radius: 20px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  color: #5d5348;\r\n}\r\n\r\n.badge-pill.alert {\r\n  background: #fde8e8;\r\n  color: #9b1c1c;\r\n}\r\n\r\n/* Loading Skeletons */\r\n.report-loading-hero {\r\n  min-height: 180px;\r\n  border-radius: 12px;\r\n  background: linear-gradient(90deg, #ede5da 0%, #faf5ee 50%, #ede5da 100%);\r\n  background-size: 200% 100%;\r\n  animation: shimmerReport 1.5s infinite;\r\n}\r\n\r\n.report-loading-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, 1fr);\r\n  gap: 14px;\r\n}\r\n\r\n.report-loading-card {\r\n  min-height: 110px;\r\n  border-radius: 10px;\r\n  background: linear-gradient(90deg, #ede5da 0%, #faf5ee 50%, #ede5da 100%);\r\n  background-size: 200% 100%;\r\n  animation: shimmerReport 1.5s infinite;\r\n}\r\n\r\n@keyframes shimmerReport {\r\n  0% { background-position: 200% 0; }\r\n  100% { background-position: -200% 0; }\r\n}\r\n\r\n/* Responsive Media Queries */\r\n@media (max-width: 1200px) {\r\n  .report-kpi-grid { grid-template-columns: repeat(3, 1fr); }\r\n  .status-funnel-grid { grid-template-columns: repeat(3, 1fr); }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .report-hero { flex-direction: column; align-items: flex-start; }\r\n  .report-hero-controls { align-items: flex-start; width: 100%; }\r\n  .report-action-buttons { width: 100%; }\r\n  .report-kpi-grid { grid-template-columns: repeat(2, 1fr); }\r\n  .report-grid-2, .report-grid-3 { grid-template-columns: 1fr; }\r\n  .status-funnel-grid { grid-template-columns: repeat(2, 1fr); }\r\n}\r\n\r\n/* Printable View */\r\n@media print {\r\n  body {\r\n    background: #fff !important;\r\n    color: #000 !important;\r\n  }\r\n\r\n  .side-nav,\r\n  .report-hero-controls,\r\n  .report-tabs-nav,\r\n  .report-metric-toggle,\r\n  .chart-legend-row {\r\n    display: none !important;\r\n  }\r\n\r\n  .app-shell {\r\n    display: block !important;\r\n  }\r\n\r\n  .report-page {\r\n    gap: 16px !important;\r\n  }\r\n\r\n  .report-hero {\r\n    background: #fff !important;\r\n    color: #000 !important;\r\n    border: 2px solid #000 !important;\r\n    box-shadow: none !important;\r\n    padding: 16px !important;\r\n  }\r\n\r\n  .report-card, .report-kpi-card {\r\n    border: 1px solid #999 !important;\r\n    box-shadow: none !important;\r\n    background: #fff !important;\r\n    break-inside: avoid;\r\n  }\r\n}\r\n/* =========================================================\r\n   FASHION HOME PAGE\r\n========================================================= */\r\n\r\n.fashion-home {\r\n  width: 100%;\r\n  overflow: hidden;\r\n  background: #f8f6f2;\r\n}\r\n\r\n/* =========================================================\r\n   HERO\r\n========================================================= */\r\n\r\n.fashion-hero {\r\n  width: min(1500px, calc(100% - 80px));\r\n  min-height: 500px;\r\n\r\n  margin: 0 auto;\r\n  padding: 42px 0 54px;\r\n\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(360px, 0.8fr);\r\n  gap: clamp(28px, 4vw, 70px);\r\n  align-items: center;\r\n}\r\n\r\n.fashion-hero-content {\r\n  max-width: 760px;\r\n}\r\n\r\n.fashion-kicker {\r\n  margin: 0 0 20px;\r\n\r\n  color: #9d664b;\r\n\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n\r\n  letter-spacing: 0.22em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.fashion-kicker::before {\r\n  content: \"\";\r\n\r\n  width: 35px;\r\n  height: 1px;\r\n\r\n  margin-right: 10px;\r\n\r\n  display: inline-block;\r\n  vertical-align: middle;\r\n\r\n  background: currentColor;\r\n}\r\n\r\n.fashion-hero h1 {\r\n  margin: 0;\r\n\r\n  font-family: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\r\n  font-size: clamp(42px, 4.4vw, 70px);\r\n  font-weight: 500;\r\n  line-height: 0.95;\r\n  letter-spacing: -0.06em;\r\n  color: #1d1a17;\r\n  text-wrap: balance;\r\n}\r\n\r\n.fashion-hero h1 span {\r\n  display: block;\r\n  color: #1d1a17;\r\n  font-family: \"Iowan Old Style\", \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\r\n  font-size: 0.86em;\r\n  font-style: normal;\r\n  font-weight: 400;\r\n  letter-spacing: -0.04em;\r\n  line-height: 0.98;\r\n}\r\n\r\n.fashion-hero-accent {\r\n  display: inline-block;\r\n  margin: 0 0.06em;\r\n\r\n  color: #b86a45;\r\n\r\n  font-family: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\r\n  font-size: 0.92em;\r\n  font-weight: 700;\r\n  letter-spacing: -0.05em;\r\n\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.fashion-hero-description {\r\n  max-width: 650px;\r\n\r\n  margin: 28px 0 0;\r\n\r\n  color: #776e66;\r\n\r\n  font-size: 15px;\r\n  line-height: 1.85;\r\n}\r\n\r\n.fashion-hero-actions {\r\n  margin-top: 34px;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.fashion-primary-button,\r\n.fashion-secondary-button {\r\n  min-height: 52px;\r\n\r\n  padding: 0 23px;\r\n\r\n  border-radius: 999px;\r\n\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n\r\n  cursor: pointer;\r\n\r\n  transition:\r\n    transform 0.2s ease,\r\n    background 0.2s ease,\r\n    border-color 0.2s ease;\r\n}\r\n\r\n.fashion-primary-button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 20px;\r\n\r\n  border: 1px solid #1f1c1a;\r\n\r\n  background: #1f1c1a;\r\n  color: #fff;\r\n}\r\n\r\n.fashion-primary-button span {\r\n  font-size: 17px;\r\n}\r\n\r\n.fashion-primary-button:hover {\r\n  background: #9d664b;\r\n  border-color: #9d664b;\r\n\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.fashion-secondary-button {\r\n  border: 1px solid #d8cec4;\r\n\r\n  background: transparent;\r\n  color: #423a34;\r\n}\r\n\r\n.fashion-secondary-button:hover {\r\n  border-color: #ab8975;\r\n  background: #efe8e1;\r\n}\r\n\r\n.fashion-stats {\r\n  margin-top: 60px;\r\n\r\n  padding-top: 28px;\r\n\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n\r\n  border-top: 1px solid #ddd5cc;\r\n}\r\n\r\n.fashion-stats div {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.fashion-stats strong {\r\n  margin-bottom: 6px;\r\n\r\n  font-family: Georgia, serif;\r\n\r\n  font-size: 22px;\r\n  font-weight: 500;\r\n}\r\n\r\n.fashion-stats span {\r\n  color: #847a72;\r\n\r\n  font-size: 10px;\r\n}\r\n\r\n/* HERO VISUAL */\r\n\r\n.fashion-hero-visual {\r\n  min-height: 430px;\r\n\r\n  position: relative;\r\n}\r\n\r\n.fashion-card-main {\r\n  width: 88%;\r\n  height: 420px;\r\n\r\n  margin-left: auto;\r\n\r\n  overflow: hidden;\r\n\r\n.product-image {\r\n  position: relative;\r\n}\r\n.wishlist-toggle {\r\n  width: 40px;\r\n  height: 40px;\r\n  min-height: 0;\r\n  display: grid;\r\n  place-items: center;\r\n  padding: 0;\r\n  border: 1px solid rgba(157, 83, 59, 0.2);\r\n  border-radius: 999px;\r\n  color: #9d533b;\r\n  background: rgba(255, 253, 249, 0.94);\r\n  font-size: 24px;\r\n  line-height: 1;\r\n  transition: color 160ms ease, background 160ms ease, transform 160ms ease;\r\n}\r\n.wishlist-toggle:hover,\r\n.wishlist-toggle.active {\r\n  color: #fff;\r\n  background: #9d533b;\r\n  transform: scale(1.05);\r\n}\r\n.product-image > .wishlist-toggle {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n}\r\n.wishlist-toggle:disabled {\r\n  opacity: 0.6;\r\n  cursor: wait;\r\n}\r\n  border-radius: 28px 28px 180px 28px;\r\n\r\n.detail-title-row {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n}\r\n.detail-title-row h1 {\r\n  min-width: 0;\r\n}\r\n.detail-wishlist-toggle {\r\n  flex: 0 0 48px;\r\n  width: 48px;\r\n  height: 48px;\r\n}\r\n  position: relative;\r\n\r\n  background:\r\n    linear-gradient(\r\n      145deg,\r\n      rgba(59, 48, 40, 0.2),\r\n      rgba(0, 0, 0, 0.05)\r\n    ),\r\n    linear-gradient(\r\n      135deg,\r\n      #c9b7aa,\r\n      #8e7768\r\n    );\r\n\r\n  box-shadow:\r\n    0 35px 80px rgba(61, 46, 36, 0.18);\r\n}\r\n\r\n.fashion-card-placeholder {\r\n  width: 100%;\r\n  height: 100%;\r\n\r\n  padding: 45px;\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: flex-end;\r\n\r\n  position: relative;\r\n\r\n  color: white;\r\n\r\n  background:\r\n    radial-gradient(\r\n      circle at 75% 20%,\r\n      rgba(255, 255, 255, 0.18),\r\n      transparent 23%\r\n    ),\r\n    linear-gradient(\r\n      to top,\r\n      rgba(24, 18, 15, 0.62),\r\n      transparent 60%\r\n    );\r\n}\r\n\r\n.fashion-card-placeholder::before {\r\n  content: \"F\";\r\n\r\n  position: absolute;\r\n\r\n  top: 45px;\r\n  right: 55px;\r\n\r\n  font-family: Georgia, serif;\r\n\r\n  font-size: 170px;\r\n  font-style: italic;\r\n\r\n  opacity: 0.12;\r\n}\r\n\r\n.fashion-card-placeholder span {\r\n  margin-bottom: 10px;\r\n\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n\r\n  letter-spacing: 0.28em;\r\n}\r\n\r\n.fashion-card-placeholder strong {\r\n  font-family: Georgia, serif;\r\n\r\n  font-size: 44px;\r\n  font-weight: 400;\r\n}\r\n\r\n.fashion-card-placeholder small {\r\n  margin-top: 7px;\r\n\r\n  font-size: 11px;\r\n  letter-spacing: 0.08em;\r\n\r\n  opacity: 0.8;\r\n}\r\n\r\n.review-form-fields {\r\n  border: 0;\r\n  padding: 0;\r\n  margin: 0 0 20px;\r\n  display: grid;\r\n  gap: 18px;\r\n  min-width: 0;\r\n}\r\n\r\n.review-product-context {\r\n  display: flex;\r\n  gap: 14px;\r\n  align-items: center;\r\n  padding: 14px;\r\n  border: 1px solid #eee7de;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n}\r\n\r\n.review-product-context img {\r\n  width: 76px;\r\n  height: 76px;\r\n  flex: 0 0 76px;\r\n  object-fit: cover;\r\n  border-radius: 6px;\r\n  background: #eee8e2;\r\n}\r\n\r\n.review-product-context div {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.review-product-context p,\r\n.review-product-context small {\r\n  margin: 0;\r\n  color: #6f6860;\r\n}\r\n\r\n.review-media-grid {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 12px;\r\n  margin: 12px 0;\r\n}\r\n\r\n.review-media-grid img,\r\n.review-media-grid video {\r\n  width: 180px;\r\n  height: 150px;\r\n  max-width: 100%;\r\n  object-fit: contain;\r\n  border-radius: 10px;\r\n  background: #eee8e2;\r\n}\r\n\r\n.fashion-floating-card {\r\n  width: 250px;\r\n\r\n  padding: 21px 23px;\r\n\r\n  position: absolute;\r\n\r\n  left: -20px;\r\n  bottom: 40px;\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n\r\n  border: 1px solid rgba(255, 255, 255, 0.65);\r\n  border-radius: 18px;\r\n\r\n  background: rgba(250, 247, 243, 0.91);\r\n\r\n  box-shadow:\r\n    0 20px 50px rgba(37, 28, 23, 0.12);\r\n\r\n  backdrop-filter: blur(18px);\r\n}\r\n\r\n.fashion-floating-card > span {\r\n  margin-bottom: 11px;\r\n\r\n  color: #9d664b;\r\n\r\n  font-size: 9px;\r\n  font-weight: 800;\r\n\r\n  letter-spacing: 0.2em;\r\n}\r\n\r\n.fashion-floating-title {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  color: #342a24;\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: clamp(25px, 2.4vw, 30px);\r\n  font-weight: 500;\r\n  line-height: 1.3;\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\n.fashion-floating-title em {\r\n  color: #925e43;\r\n  font-size: 1.18em;\r\n  font-weight: 500;\r\n}\r\n\r\n.fashion-floating-title::after {\r\n  content: \"\";\r\n  width: 32px;\r\n  height: 1px;\r\n  margin: 10px 0 8px;\r\n  background: #b68c70;\r\n}\r\n\r\n.fashion-floating-card small {\r\n  margin-top: 5px;\r\n\r\n  color: #82776e;\r\n\r\n  font-size: 9px;\r\n}\r\n\r\n/* =========================================================\r\n   BENEFITS\r\n========================================================= */\r\n\r\n.fashion-benefits {\r\n  width: 100%;\r\n\r\n  padding: 27px clamp(30px, 6vw, 90px);\r\n\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n\r\n  border-top: 1px solid #e1d8d0;\r\n  border-bottom: 1px solid #e1d8d0;\r\n\r\n  background: #f1ece6;\r\n}\r\n\r\n.fashion-benefits > div {\r\n  padding: 0 28px;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n\r\n.fashion-benefits > div:not(:last-child) {\r\n  border-right: 1px solid #dcd2c9;\r\n}\r\n\r\n.fashion-benefit-icon {\r\n  width: 36px;\r\n  height: 36px;\r\n\r\n  flex: 0 0 36px;\r\n\r\n  display: grid;\r\n  place-items: center;\r\n\r\n  border-radius: 50%;\r\n\r\n  background: #e5dcd4;\r\n  color: #795b49;\r\n\r\n  font-size: 13px;\r\n}\r\n\r\n.fashion-benefits div div {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.fashion-benefits strong {\r\n  font-size: 11px;\r\n}\r\n\r\n.fashion-benefits small {\r\n  margin-top: 3px;\r\n\r\n  color: #8b8077;\r\n\r\n  font-size: 9px;\r\n}\r\n\r\n/* =========================================================\r\n   SECTION\r\n========================================================= */\r\n\r\n.fashion-collection-section,\r\n.fashion-products-section {\r\n  width: min(1450px, calc(100% - 80px));\r\n\r\n  margin: 0 auto;\r\n\r\n  padding: 56px 0;\r\n}\r\n\r\n.fashion-section-heading {\r\n  margin-bottom: 38px;\r\n\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-end;\r\n  gap: 30px;\r\n}\r\n\r\n.fashion-section-heading h2 {\r\n  margin: 0;\r\n\r\n  font-family: Georgia, serif;\r\n\r\n  font-size: clamp(34px, 3.2vw, 50px);\r\n  font-weight: 500;\r\n\r\n  letter-spacing: -0.03em;\r\n}\r\n\r\n.fashion-section-description {\r\n  margin: 11px 0 0;\r\n\r\n  color: #81776e;\r\n\r\n  font-size: 12px;\r\n}\r\n\r\n.fashion-text-button {\r\n  min-height: auto;\r\n\r\n  padding: 10px 0;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n\r\n  border: none;\r\n\r\n  background: transparent;\r\n  color: #4f453e;\r\n\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n\r\n  cursor: pointer;\r\n}\r\n\r\n.fashion-text-button:hover {\r\n  background: transparent;\r\n  color: #9d664b;\r\n}\r\n\r\n/* =========================================================\r\n   COLLECTION CARDS\r\n========================================================= */\r\n\r\n.fashion-collection-grid {\r\n  min-height: 420px;\r\n\r\n  display: grid;\r\n\r\n  grid-template-columns: 1.35fr 0.75fr;\r\n  grid-template-rows: 1fr 1fr;\r\n\r\n  gap: 18px;\r\n}\r\n\r\n.fashion-collection-card {\r\n  min-height: 250px;\r\n\r\n  padding: 0;\r\n\r\n  overflow: hidden;\r\n\r\n  position: relative;\r\n\r\n  border: none;\r\n  border-radius: 22px;\r\n\r\n  text-align: left;\r\n\r\n  cursor: pointer;\r\n\r\n  background: #9d897b;\r\n}\r\n\r\n.fashion-collection-large {\r\n  grid-row: 1 / 3;\r\n}\r\n\r\n.fashion-collection-background {\r\n  position: absolute;\r\n  inset: 0;\r\n\r\n  transition: transform 0.5s ease;\r\n\r\n  background-size: cover;\r\n  background-position: center;\r\n}\r\n\r\n.collection-one {\r\n  background:\r\n    linear-gradient(\r\n      to top,\r\n      rgba(34, 26, 21, 0.72),\r\n      rgba(0, 0, 0, 0.05) 65%\r\n    ),\r\n    linear-gradient(\r\n      145deg,\r\n      #816d61,\r\n      #c7b2a2\r\n    );\r\n}\r\n\r\n.collection-two {\r\n  background:\r\n    linear-gradient(\r\n      to right,\r\n      rgba(35, 29, 25, 0.68),\r\n      transparent\r\n    ),\r\n    linear-gradient(\r\n      135deg,\r\n      #b9aa9d,\r\n      #8c7d70\r\n    );\r\n}\r\n\r\n.collection-three {\r\n  background:\r\n    linear-gradient(\r\n      to right,\r\n      rgba(33, 26, 22, 0.68),\r\n      transparent\r\n    ),\r\n    linear-gradient(\r\n      135deg,\r\n      #9f8979,\r\n      #d2c2b5\r\n    );\r\n}\r\n\r\n.fashion-collection-card:hover .fashion-collection-background {\r\n  transform: scale(1.045);\r\n}\r\n\r\n.fashion-collection-content {\r\n  width: 100%;\r\n  height: 100%;\r\n\r\n  padding: 35px;\r\n\r\n  position: relative;\r\n  z-index: 2;\r\n\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: flex-end;\r\n\r\n  color: #fff;\r\n}\r\n\r\n.fashion-collection-content small {\r\n  margin-bottom: 9px;\r\n\r\n  font-size: 9px;\r\n  font-weight: 700;\r\n\r\n  letter-spacing: 0.2em;\r\n\r\n  opacity: 0.8;\r\n}\r\n\r\n.fashion-collection-content h3 {\r\n  margin: 0;\r\n\r\n  font-family: Georgia, serif;\r\n\r\n  font-size: 28px;\r\n  font-weight: 400;\r\n\r\n  line-height: 1.08;\r\n}\r\n\r\n.fashion-collection-large h3 {\r\n  font-size: 40px;\r\n}\r\n\r\n.fashion-collection-content span {\r\n  margin-top: 20px;\r\n\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n\r\n  letter-spacing: 0.06em;\r\n}\r\n\r\n/* =========================================================\r\n   PRODUCT LIST\r\n========================================================= */\r\n\r\n.fashion-products-section {\r\n  padding-top: 40px;\r\n}\r\n\r\n.fashion-product-list-wrapper {\r\n  width: 100%;\r\n}\r\n\r\n/*\r\n   ProductListPage có thể đang có margin/padding riêng.\r\n   Dòng này giúp nó hòa vào HomePage hơn.\r\n*/\r\n\r\n.fashion-product-list-wrapper .page-stack {\r\n  width: 100%;\r\n}\r\n\r\n/* =========================================================\r\n   SIZE BANNER\r\n========================================================= */\r\n\r\n.fashion-size-banner {\r\n  width: min(1450px, calc(100% - 80px));\r\n\r\n  min-height: 270px;\r\n\r\n  margin: 0 auto 100px;\r\n  padding: 50px 60px;\r\n\r\n  overflow: hidden;\r\n\r\n  position: relative;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 50px;\r\n\r\n  border-radius: 28px;\r\n\r\n  background:\r\n    linear-gradient(\r\n      120deg,\r\n      #1f1c1a,\r\n      #41362f\r\n    );\r\n\r\n  color: white;\r\n}\r\n\r\n.fashion-size-decoration {\r\n  width: 420px;\r\n  height: 420px;\r\n\r\n  position: absolute;\r\n\r\n  right: 8%;\r\n  top: -220px;\r\n\r\n  border: 1px solid rgba(255, 255, 255, 0.09);\r\n  border-radius: 50%;\r\n}\r\n\r\n.fashion-size-decoration::after {\r\n  content: \"\";\r\n\r\n  width: 300px;\r\n  height: 300px;\r\n\r\n  position: absolute;\r\n\r\n  left: 60px;\r\n  top: 60px;\r\n\r\n  border: 1px solid rgba(255, 255, 255, 0.09);\r\n  border-radius: 50%;\r\n}\r\n\r\n.fashion-size-content {\r\n  max-width: 760px;\r\n\r\n  position: relative;\r\n  z-index: 2;\r\n}\r\n\r\n.fashion-kicker.light {\r\n  color: #c9a38d;\r\n}\r\n\r\n.fashion-size-content h2 {\r\n  margin: 0;\r\n\r\n  font-family: Georgia, serif;\r\n\r\n  font-size: clamp(33px, 3vw, 48px);\r\n  font-weight: 400;\r\n}\r\n\r\n.fashion-size-content > p:last-child {\r\n  max-width: 620px;\r\n\r\n  margin: 15px 0 0;\r\n\r\n  color: #c9c0ba;\r\n\r\n  font-size: 13px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.fashion-size-button {\r\n  min-width: 180px;\r\n  min-height: 52px;\r\n\r\n  padding: 0 22px;\r\n\r\n  position: relative;\r\n  z-index: 2;\r\n\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 20px;\r\n\r\n  border: none;\r\n  border-radius: 999px;\r\n\r\n  background: white;\r\n  color: #1f1c1a;\r\n\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n\r\n  cursor: pointer;\r\n}\r\n\r\n.fashion-size-button:hover {\r\n  background: #eadfd7;\r\n}\r\n\r\n/* =========================================================\r\n   RESPONSIVE\r\n========================================================= */\r\n\r\n@media (max-width: 1100px) {\r\n  .fashion-hero {\r\n    grid-template-columns: 1fr;\r\n\r\n    padding-top: 60px;\r\n  }\r\n\r\n  .fashion-hero-visual {\r\n    width: min(650px, 100%);\r\n\r\n    margin: auto;\r\n  }\r\n\r\n  .fashion-benefits {\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 25px 0;\r\n  }\r\n\r\n  .fashion-benefits > div:nth-child(2) {\r\n    border-right: none;\r\n  }\r\n}\r\n\r\n@media (max-width: 800px) {\r\n  .fashion-hero,\r\n  .fashion-collection-section,\r\n  .fashion-products-section,\r\n  .fashion-size-banner {\r\n    width: calc(100% - 32px);\r\n  }\r\n\r\n  .fashion-hero h1 {\r\n    font-size: 52px;\r\n  }\r\n\r\n  .fashion-collection-grid {\r\n    min-height: auto;\r\n\r\n    grid-template-columns: 1fr;\r\n    grid-template-rows: auto;\r\n  }\r\n\r\n  .fashion-collection-large {\r\n    grid-row: auto;\r\n  }\r\n\r\n  .fashion-collection-card {\r\n    min-height: 350px;\r\n  }\r\n\r\n  .fashion-collection-large {\r\n    min-height: 480px;\r\n  }\r\n\r\n  .fashion-size-banner {\r\n    padding: 40px 30px;\r\n\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n}\r\n\r\n@media (max-width: 620px) {\r\n  .fashion-hero {\r\n    width: calc(100% - 28px);\r\n\r\n    padding: 45px 0 65px;\r\n  }\r\n\r\n  .fashion-hero h1 {\r\n    font-size: 43px;\r\n  }\r\n\r\n  .fashion-hero-description {\r\n    font-size: 13px;\r\n  }\r\n\r\n  .fashion-hero-actions {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n  }\r\n\r\n  .fashion-primary-button,\r\n  .fashion-secondary-button {\r\n    width: 100%;\r\n  }\r\n\r\n  .fashion-stats {\r\n    gap: 15px;\r\n  }\r\n\r\n  .fashion-stats strong {\r\n    font-size: 17px;\r\n  }\r\n\r\n  .fashion-stats span {\r\n    font-size: 8px;\r\n  }\r\n\r\n  .fashion-hero-visual {\r\n    min-height: 430px;\r\n  }\r\n\r\n  .fashion-card-main {\r\n    width: 100%;\r\n    height: 430px;\r\n\r\n    border-radius: 22px 22px 100px 22px;\r\n  }\r\n\r\n  .fashion-card-placeholder {\r\n    padding: 28px;\r\n  }\r\n\r\n  .fashion-card-placeholder strong {\r\n    font-size: 34px;\r\n  }\r\n\r\n  .fashion-floating-card {\r\n    width: 215px;\r\n\r\n    left: 15px;\r\n    bottom: 20px;\r\n  }\r\n\r\n  .fashion-benefits {\r\n    padding: 25px 20px;\r\n\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .fashion-benefits > div {\r\n    padding: 0;\r\n  }\r\n\r\n  .fashion-benefits > div:not(:last-child) {\r\n    padding-bottom: 20px;\r\n\r\n    border-right: none;\r\n    border-bottom: 1px solid #ded5cd;\r\n  }\r\n\r\n  .fashion-collection-section,\r\n  .fashion-products-section {\r\n    padding: 70px 0;\r\n  }\r\n\r\n  .fashion-section-heading {\r\n    align-items: flex-start;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .fashion-section-heading h2 {\r\n    font-size: 35px;\r\n  }\r\n\r\n  .fashion-collection-card,\r\n  .fashion-collection-large {\r\n    min-height: 380px;\r\n  }\r\n\r\n  .fashion-collection-large h3,\r\n  .fashion-collection-content h3 {\r\n    font-size: 37px;\r\n  }\r\n\r\n  .fashion-size-banner {\r\n    width: calc(100% - 28px);\r\n\r\n    margin-bottom: 60px;\r\n  }\r\n\r\n  .fashion-size-button {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n.shipment-panel { margin-top: 24px; padding: 20px; border: 1px solid #e2e5e9; border-radius: 12px; overflow-wrap: anywhere; }\r\n.shipment-panel form { display: grid; gap: 12px; margin: 20px 0; }\r\n.shipment-panel label { display: grid; gap: 6px; }\r\n.shipment-panel input, .shipment-panel select { width: 100%; min-width: 0; padding: 10px; box-sizing: border-box; }\r\n.shipment-timeline { padding-left: 22px; }\r\n.shipment-timeline li { padding: 0 0 16px 8px; }\r\n.shipment-timeline small { display: block; color: #666; margin-top: 6px; }\r\n.shipment-timeline p { margin: 6px 0; }\r\n\r\n.delivery-map-wrapper { position: relative; width: 100%; height: 380px; overflow: hidden; border-radius: 12px; isolation: isolate; }\r\n.delivery-map { width: 100%; height: 100%; }\r\n.delivery-fixed-pin { position: absolute; z-index: 1000; left: 50%; top: 50%; transform: translate(-50%, -100%); pointer-events: none; font-size: 40px; line-height: 1; }\r\n.delivery-search { display: flex; gap: 8px; margin-top: 12px; }\r\n.delivery-search input { min-width: 0; flex: 1; }\r\n.delivery-results { list-style: none; padding: 0; max-height: 220px; overflow-y: auto; }\r\n.delivery-results button { width: 100%; text-align: left; margin-bottom: 6px; }\r\n.shipment-map { isolation: isolate; border-radius: 12px; overflow: hidden; }\r\n.shipment-map-icon { font-size: 30px; line-height: 36px; text-align: center; }\r\n\r\n/* Editorial blush treatment for the guest storefront home page. */\r\n.fashion-home {\r\n  background:\r\n    radial-gradient(ellipse at 88% 8%, rgba(255, 219, 232, 0.72), transparent 32%),\r\n    linear-gradient(180deg, #fff7fa 0%, #fff1f5 48%, #fff8f7 100%);\r\n}\r\n\r\n.fashion-hero {\r\n  position: relative;\r\n  isolation: isolate;\r\n}\r\n\r\n.fashion-hero::before {\r\n  position: absolute;\r\n  z-index: -1;\r\n  inset: 18px -40px 24px;\r\n  border: 1px solid rgba(224, 160, 183, 0.2);\r\n  border-radius: 34px;\r\n  background:\r\n    radial-gradient(ellipse at 12% 0%, rgba(255, 255, 255, 0.8), transparent 56%),\r\n    linear-gradient(120deg, rgba(255, 236, 243, 0.7), rgba(255, 248, 247, 0.25));\r\n  content: \"\";\r\n}\r\n\r\n.fashion-kicker {\r\n  color: #a84f70;\r\n}\r\n\r\n.fashion-hero-accent {\r\n  color: #c45e83;\r\n}\r\n\r\n.fashion-hero-description {\r\n  color: #74636a;\r\n}\r\n\r\n.fashion-primary-button {\r\n  border-color: #a94368;\r\n  background: linear-gradient(115deg, #a94368, #c96888);\r\n  box-shadow: 0 10px 24px rgba(169, 67, 104, 0.2);\r\n}\r\n\r\n.fashion-primary-button:hover {\r\n  border-color: #923653;\r\n  background: linear-gradient(115deg, #923653, #b95376);\r\n}\r\n\r\n.fashion-secondary-button {\r\n  border-color: rgba(184, 105, 134, 0.35);\r\n  background: rgba(255, 255, 255, 0.56);\r\n  color: #79455a;\r\n}\r\n\r\n.fashion-secondary-button:hover {\r\n  border-color: rgba(184, 105, 134, 0.58);\r\n  background: #ffe8ef;\r\n}\r\n\r\n.fashion-stats {\r\n  border-top-color: rgba(196, 133, 156, 0.34);\r\n}\r\n\r\n.fashion-stats strong {\r\n  color: #402d35;\r\n}\r\n\r\n.fashion-stats span {\r\n  color: #806d75;\r\n}\r\n\r\n.fashion-card-main {\r\n  background:\r\n    radial-gradient(ellipse at 72% 24%, rgba(255, 235, 243, 0.68), transparent 31%),\r\n    radial-gradient(ellipse at 14% 88%, rgba(238, 167, 188, 0.34), transparent 36%),\r\n    linear-gradient(145deg, #d6aab7 0%, #b8798e 48%, #624651 100%);\r\n  box-shadow: 0 32px 76px rgba(126, 69, 91, 0.23);\r\n}\r\n\r\n.fashion-card-placeholder {\r\n  background:\r\n    radial-gradient(circle at 76% 20%, rgba(255, 255, 255, 0.32), transparent 23%),\r\n    linear-gradient(120deg, transparent 35%, rgba(255, 255, 255, 0.1) 50%, transparent 65%),\r\n    linear-gradient(to top, rgba(48, 28, 38, 0.64), rgba(80, 43, 59, 0.02) 72%);\r\n  background-size: auto, 220% 100%, auto;\r\n  animation: fashion-poster-glow 18s ease-in-out infinite alternate;\r\n}\r\n\r\n.fashion-card-placeholder::before {\r\n  color: #fff2f6;\r\n  opacity: 0.2;\r\n}\r\n\r\n.fashion-card-placeholder strong {\r\n  text-shadow: 0 2px 18px rgba(55, 27, 39, 0.18);\r\n}\r\n\r\n.fashion-floating-card {\r\n  border-color: rgba(255, 255, 255, 0.78);\r\n  background: rgba(255, 249, 251, 0.9);\r\n  box-shadow: 0 24px 58px rgba(111, 57, 78, 0.18);\r\n}\r\n\r\n.fashion-floating-card > span,\r\n.fashion-floating-title em {\r\n  color: #ad4f72;\r\n}\r\n\r\n.fashion-floating-title {\r\n  font-family: \"Segoe UI\", Inter, ui-sans-serif, system-ui, sans-serif;\r\n  font-size: clamp(21px, 2vw, 25px);\r\n  font-weight: 650;\r\n  line-height: 1.2;\r\n  letter-spacing: -0.035em;\r\n}\r\n\r\n.fashion-floating-title em {\r\n  font-size: 1em;\r\n  font-style: normal;\r\n  font-weight: 750;\r\n  letter-spacing: -0.025em;\r\n}\r\n\r\n.fashion-floating-title::after {\r\n  background: #d58aa4;\r\n}\r\n\r\n.fashion-size-banner {\r\n  border: 1px solid rgba(190, 91, 126, 0.18);\r\n  background:\r\n    radial-gradient(ellipse at 88% 12%, rgba(255, 255, 255, 0.74), transparent 34%),\r\n    linear-gradient(118deg, #f4c9d8 0%, #f8dce6 52%, #f5d2df 100%);\r\n  box-shadow: 0 24px 60px rgba(145, 71, 99, 0.14);\r\n  color: #402832;\r\n}\r\n\r\n.fashion-size-decoration,\r\n.fashion-size-decoration::after {\r\n  border-color: rgba(166, 72, 105, 0.16);\r\n}\r\n\r\n.fashion-size-content h2 {\r\n  max-width: 720px;\r\n  color: #462b37;\r\n  font-family: \"Segoe UI\", Inter, ui-sans-serif, system-ui, sans-serif;\r\n  font-size: clamp(28px, 3vw, 42px);\r\n  font-weight: 700;\r\n  line-height: 1.2;\r\n  letter-spacing: -0.035em;\r\n  text-wrap: balance;\r\n}\r\n\r\n.fashion-kicker.light {\r\n  color: #984765;\r\n}\r\n\r\n.fashion-size-content > p:last-child {\r\n  color: #72505e;\r\n}\r\n\r\n.fashion-size-button {\r\n  border: 1px solid rgba(255, 255, 255, 0.72);\r\n  background: linear-gradient(115deg, #a94368, #c96888);\r\n  box-shadow: 0 10px 24px rgba(151, 55, 91, 0.18);\r\n  color: #fff;\r\n  font-family: \"Segoe UI\", Inter, ui-sans-serif, system-ui, sans-serif;\r\n  font-size: 12px;\r\n}\r\n\r\n.fashion-size-button:hover {\r\n  background: linear-gradient(115deg, #923653, #b95376);\r\n}\r\n\r\n.fashion-benefits {\r\n  border-top-color: rgba(205, 125, 154, 0.24);\r\n  border-bottom-color: rgba(205, 125, 154, 0.24);\r\n  background:\r\n    linear-gradient(105deg, rgba(255, 224, 234, 0.94), rgba(255, 239, 244, 0.96) 48%, rgba(255, 228, 235, 0.94));\r\n}\r\n\r\n.fashion-benefits > div:not(:last-child) {\r\n  border-right-color: rgba(190, 120, 145, 0.25);\r\n}\r\n\r\n.fashion-benefit-icon {\r\n  border: 1px solid rgba(191, 94, 127, 0.1);\r\n  background: linear-gradient(145deg, #fff8fa, #f8dce6);\r\n  box-shadow: 0 5px 14px rgba(165, 77, 107, 0.1);\r\n  color: #a4486a;\r\n}\r\n\r\n.fashion-benefits strong {\r\n  color: #49323c;\r\n}\r\n\r\n.fashion-benefits small {\r\n  color: #806b74;\r\n}\r\n\r\n.fashion-section-heading h2 {\r\n  color: #382a31;\r\n}\r\n\r\n.fashion-text-button {\r\n  color: #a84f70;\r\n}\r\n\r\n.collection-one {\r\n  background:\r\n    linear-gradient(to top, rgba(52, 29, 40, 0.72), rgba(52, 29, 40, 0.02) 70%),\r\n    linear-gradient(145deg, #bd8599, #e9c4d0);\r\n}\r\n\r\n.collection-two {\r\n  background:\r\n    linear-gradient(to right, rgba(70, 39, 54, 0.62), transparent),\r\n    linear-gradient(135deg, #e9c8d2, #ad7488);\r\n}\r\n\r\n.collection-three {\r\n  background:\r\n    linear-gradient(to right, rgba(70, 39, 54, 0.62), transparent),\r\n    linear-gradient(135deg, #bd8799, #f0d7df);\r\n}\r\n\r\n.fashion-product-list-wrapper .catalog-panel {\r\n  min-width: 0;\r\n  padding: 0 16px 16px;\r\n  border: 1px solid rgba(202, 126, 154, 0.3);\r\n  border-radius: 22px;\r\n  background: linear-gradient(145deg, #fbe4ec, #fff0f5);\r\n  box-shadow: 0 18px 48px rgba(152, 74, 103, 0.1);\r\n}\r\n\r\n.fashion-product-list-wrapper {\r\n  min-width: 0;\r\n  container-type: inline-size;\r\n}\r\n\r\n.fashion-product-list-wrapper .store-grid {\r\n  grid-template-columns: minmax(0, 1fr);\r\n}\r\n\r\n.fashion-product-list-wrapper .catalog-summary {\r\n  padding-top: 20px;\r\n}\r\n\r\n.fashion-product-list-wrapper .catalog-summary h2 {\r\n  color: #482f3a;\r\n}\r\n\r\n.fashion-product-list-wrapper .summary-pills span,\r\n.fashion-product-list-wrapper .mini-meta span {\r\n  background: #f7dfe8;\r\n  color: #754357;\r\n}\r\n\r\n.fashion-product-list-wrapper .catalog-category-pills {\r\n  padding: 0 2px;\r\n}\r\n\r\n.fashion-product-list-wrapper .category-pill-btn {\r\n  border-color: rgba(190, 120, 145, 0.28);\r\n  background: rgba(255, 255, 255, 0.66);\r\n  color: #714657;\r\n}\r\n\r\n.fashion-product-list-wrapper .category-pill-btn:hover,\r\n.fashion-product-list-wrapper .category-pill-btn.active {\r\n  border-color: #ad4f72;\r\n  background: #ad4f72;\r\n  color: #fff;\r\n  box-shadow: 0 5px 14px rgba(173, 79, 114, 0.2);\r\n}\r\n\r\n.fashion-product-list-wrapper .product-card {\r\n  border-color: rgba(190, 112, 142, 0.38);\r\n  border-radius: 14px;\r\n  background: linear-gradient(155deg, #fff2f6, #fce5ed);\r\n  box-shadow: 0 8px 22px rgba(125, 66, 87, 0.07);\r\n  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\r\n}\r\n\r\n.fashion-product-list-wrapper .product-card:hover {\r\n  transform: translateY(-3px);\r\n  border-color: rgba(173, 79, 114, 0.55);\r\n  box-shadow: 0 14px 28px rgba(125, 66, 87, 0.13);\r\n}\r\n\r\n.fashion-product-list-wrapper .product-card.selected {\r\n  outline-color: rgba(173, 79, 114, 0.72);\r\n}\r\n\r\n.fashion-product-list-wrapper .product-detail-experience {\r\n  width: 100%;\r\n  min-width: 0;\r\n  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);\r\n  gap: 16px;\r\n}\r\n\r\n.fashion-product-list-wrapper .product-detail-gallery {\r\n  padding: 12px;\r\n  border: 1px solid rgba(190, 112, 142, 0.36);\r\n  border-radius: 20px;\r\n  background: linear-gradient(145deg, #f9dfe8, #f6d8e3);\r\n  box-shadow: 0 16px 36px rgba(152, 74, 103, 0.1);\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-back-button,\r\n.fashion-product-list-wrapper .detail-thumbnail {\r\n  border-color: rgba(190, 120, 145, 0.3);\r\n  background: rgba(255, 250, 252, 0.92);\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-thumbnail:hover,\r\n.fashion-product-list-wrapper .detail-thumbnail.active {\r\n  border-color: #ad4f72;\r\n  outline-color: rgba(173, 79, 114, 0.2);\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-buy-panel {\r\n  border-color: rgba(190, 112, 142, 0.4);\r\n  background: linear-gradient(155deg, #f9e2ea 0%, #f5d7e2 100%);\r\n  box-shadow: 0 18px 40px rgba(152, 74, 103, 0.11);\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-product-heading,\r\n.fashion-product-list-wrapper .detail-price-row,\r\n.fashion-product-list-wrapper .detail-option-group,\r\n.fashion-product-list-wrapper .detail-spec-grid {\r\n  min-width: 0;\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-buy-panel .detail-add-button {\r\n  border-color: #ad4f72;\r\n  background: #fff5f8;\r\n  color: #984765;\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-buy-panel .detail-add-button:hover {\r\n  background: #ad4f72;\r\n  color: #fff;\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-buy-now-button {\r\n  background: linear-gradient(115deg, #a94368, #c96888);\r\n}\r\n\r\n.fashion-product-list-wrapper .detail-buy-now-button:hover {\r\n  background: linear-gradient(115deg, #923653, #b95376);\r\n}\r\n\r\n@container (max-width: 1200px) {\r\n  .fashion-product-list-wrapper .product-detail-gallery {\r\n    position: static;\r\n  }\r\n\r\n  .fashion-product-list-wrapper .detail-hero-image {\r\n    min-height: clamp(260px, 42cqw, 520px);\r\n    aspect-ratio: 4 / 3;\r\n  }\r\n}\r\n\r\n@container (max-width: 760px) {\r\n  .fashion-product-list-wrapper .product-detail-experience {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n\r\n  .fashion-product-list-wrapper .detail-hero-image {\r\n    min-height: 0;\r\n    aspect-ratio: 4 / 3;\r\n  }\r\n\r\n  .fashion-product-list-wrapper .detail-buy-panel {\r\n    padding: clamp(18px, 4cqw, 28px);\r\n    gap: clamp(16px, 3cqw, 22px);\r\n  }\r\n}\r\n\r\n@container (max-width: 480px) {\r\n  .fashion-product-list-wrapper .detail-purchase-row,\r\n  .fashion-product-list-wrapper .detail-action-pair,\r\n  .fashion-product-list-wrapper .detail-spec-grid {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n}\r\n\r\n@keyframes fashion-poster-glow {\r\n  from {\r\n    background-position: center, 100% 0, center;\r\n  }\r\n\r\n  to {\r\n    background-position: center, 0 0, center;\r\n  }\r\n}\r\n\r\n@media (max-width: 620px) {\r\n  .fashion-hero::before {\r\n    inset: 12px -14px 24px;\r\n    border-radius: 26px;\r\n  }\r\n\r\n  .fashion-benefits > div:not(:last-child) {\r\n    border-bottom-color: rgba(190, 120, 145, 0.25);\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .fashion-card-placeholder {\r\n    animation: none;\r\n  }\r\n}\r\n\r\n.guest-header {\r\n  position: relative;\r\n  z-index: 5;\r\n  grid-template-columns: auto minmax(0, 1fr) auto;\r\n  gap: clamp(14px, 2.2vw, 34px);\r\n  padding: 12px clamp(16px, 3vw, 48px);\r\n  border-bottom: 1px solid rgba(190, 112, 142, 0.22);\r\n  background:\r\n    radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.82), transparent 65%),\r\n    rgba(255, 243, 247, 0.94);\r\n  box-shadow: 0 8px 30px rgba(139, 66, 94, 0.07);\r\n  backdrop-filter: blur(18px);\r\n}\r\n\r\n.guest-brand {\r\n  justify-self: start;\r\n  min-height: 48px;\r\n  padding: 8px 14px;\r\n  border: 1px solid rgba(190, 112, 142, 0.22);\r\n  border-radius: 16px;\r\n  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), #f9e7ee);\r\n  box-shadow: 0 7px 20px rgba(152, 74, 103, 0.11), inset 0 1px 0 rgba(255, 255, 255, 0.9);\r\n  color: #512c3c;\r\n  transition: transform 180ms ease, box-shadow 180ms ease;\r\n}\r\n\r\n.guest-brand:hover {\r\n  transform: translateY(-1px);\r\n  border-color: rgba(173, 79, 114, 0.34);\r\n  box-shadow: 0 10px 24px rgba(152, 74, 103, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.94);\r\n}\r\n\r\n.guest-brand-logo {\r\n  width: 28px;\r\n  height: 28px;\r\n  flex: 0 0 auto;\r\n  border-radius: 9px;\r\n  border: 1px solid rgba(190, 112, 142, 0.18);\r\n  background: linear-gradient(145deg, #fff5f8, #f5d8e3);\r\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.88), 0 3px 8px rgba(152, 74, 103, 0.1);\r\n  color: #a94368;\r\n}\r\n\r\n.guest-brand-info strong {\r\n  font-size: 17px;\r\n  letter-spacing: 0.045em;\r\n}\r\n\r\n.guest-brand-info small {\r\n  color: #a56e83;\r\n  font-size: 8px;\r\n}\r\n\r\n.guest-navigation {\r\n  width: min(100%, 780px);\r\n  min-width: 0;\r\n  justify-self: center;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 6px;\r\n  padding: 5px;\r\n  border: 1px solid rgba(190, 112, 142, 0.13);\r\n  border-radius: 17px;\r\n  background: rgba(255, 255, 255, 0.48);\r\n}\r\n\r\n.guest-navigation button {\r\n  position: relative;\r\n  display: flex;\r\n  min-width: 0;\r\n  min-height: 44px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 14px;\r\n  border: 1px solid transparent;\r\n  border-radius: 12px;\r\n  color: #6b4a59;\r\n  font-size: 14px;\r\n  font-weight: 650;\r\n  white-space: nowrap;\r\n  transition: color 160ms ease, background 160ms ease, box-shadow 160ms ease;\r\n}\r\n\r\n.guest-navigation button:hover {\r\n  background: rgba(250, 224, 234, 0.72);\r\n  color: #9d4565;\r\n}\r\n\r\n.guest-navigation button.active {\r\n  border-color: rgba(190, 83, 121, 0.15);\r\n  border-radius: 12px;\r\n  background: linear-gradient(135deg, #f7dce6, #fceaf0);\r\n  box-shadow: 0 3px 10px rgba(152, 74, 103, 0.09);\r\n  color: #9d3f61;\r\n}\r\n\r\n.guest-navigation button.active::after {\r\n  position: absolute;\r\n  right: 14px;\r\n  bottom: 5px;\r\n  left: 14px;\r\n  height: 2px;\r\n  border-radius: 2px;\r\n  background: linear-gradient(90deg, #bd6685, #e3a2b8);\r\n  content: \"\";\r\n}\r\n\r\n.guest-header-actions {\r\n  justify-self: end;\r\n  gap: 8px;\r\n}\r\n\r\n.guest-sign-in,\r\n.guest-sign-up {\r\n  min-height: 42px;\r\n  padding: 0 16px;\r\n  border-radius: 13px;\r\n  font-size: 13px;\r\n  transition: color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease;\r\n}\r\n\r\n.guest-sign-in {\r\n  border: 1px solid transparent;\r\n  color: #754b5d;\r\n}\r\n\r\n.guest-sign-in:hover {\r\n  background: rgba(250, 224, 234, 0.72);\r\n  color: #9d3f61;\r\n}\r\n\r\n.guest-sign-up {\r\n  border: 1px solid rgba(169, 67, 104, 0.18);\r\n  background: linear-gradient(115deg, #a94368, #c96888);\r\n  box-shadow: 0 6px 16px rgba(169, 67, 104, 0.2);\r\n  color: #fff;\r\n}\r\n\r\n.guest-sign-up:hover {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 9px 20px rgba(169, 67, 104, 0.28);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .guest-header {\r\n    grid-template-columns: minmax(0, 1fr) auto;\r\n    gap: 12px 18px;\r\n    padding: 12px 20px;\r\n  }\r\n\r\n  .guest-navigation {\r\n    grid-column: 1 / -1;\r\n    grid-row: 2;\r\n    width: 100%;\r\n    max-width: none;\r\n  }\r\n}\r\n\r\n@media (max-width: 620px) {\r\n  .guest-header {\r\n    gap: 10px;\r\n    padding: 10px 14px;\r\n  }\r\n\r\n  .guest-brand {\r\n    gap: 9px;\r\n    min-height: 44px;\r\n    padding: 7px 10px;\r\n    border-radius: 14px;\r\n  }\r\n\r\n  .guest-brand-logo {\r\n    width: 25px;\r\n    height: 25px;\r\n  }\r\n\r\n  .guest-brand-info strong {\r\n    font-size: 15px;\r\n  }\r\n\r\n  .guest-brand-info small {\r\n    font-size: 7px;\r\n  }\r\n\r\n  .guest-header-actions {\r\n    gap: 4px;\r\n  }\r\n\r\n  .guest-sign-in,\r\n  .guest-sign-up {\r\n    min-height: 38px;\r\n    padding: 0 10px;\r\n    border-radius: 11px;\r\n    font-size: 12px;\r\n  }\r\n\r\n  .guest-navigation {\r\n    display: flex;\r\n    justify-self: stretch;\r\n    gap: 4px;\r\n    overflow-x: auto;\r\n    padding: 4px;\r\n    scrollbar-width: none;\r\n  }\r\n\r\n  .guest-navigation::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n\r\n  .guest-navigation button {\r\n    flex: 0 0 auto;\r\n    min-height: 40px;\r\n    padding: 0 13px;\r\n    font-size: 12px;\r\n  }\r\n\r\n  .guest-navigation button.active::after {\r\n    right: 12px;\r\n    bottom: 4px;\r\n    left: 12px;\r\n  }\r\n}\r\n\r\n@media (max-width: 360px) {\r\n  .guest-header {\r\n    padding-inline: 10px;\r\n  }\r\n\r\n  .guest-brand {\r\n    gap: 7px;\r\n    padding-inline: 8px;\r\n  }\r\n\r\n  .guest-brand-info strong {\r\n    font-size: 14px;\r\n  }\r\n\r\n  .guest-sign-in,\r\n  .guest-sign-up {\r\n    padding-inline: 8px;\r\n    font-size: 11px;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .guest-brand,\r\n  .guest-navigation button,\r\n  .guest-sign-in,\r\n  .guest-sign-up {\r\n    transition: none;\r\n  }\r\n}\r\n\r\n.fashion-logo-mark {\r\n  display: grid;\r\n  place-items: center;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.fashion-logo-mark svg {\r\n  display: block;\r\n  width: 78%;\r\n  height: 78%;\r\n  overflow: visible;\r\n}\r\n\r\n.guest-brand-logo {\r\n  border: 1px solid rgba(255, 255, 255, 0.55);\r\n}\r\n\r\n.guest-footer-mark {\r\n  background: linear-gradient(145deg, #fff5f8, #f8dfe8);\r\n  color: #a94368;\r\n}\r\n\r\n.brand-mark-icon {\r\n  display: grid;\r\n  width: 42px;\r\n  height: 42px;\r\n  flex: 0 0 auto;\r\n  place-items: center;\r\n  border: 1px solid rgba(190, 112, 142, 0.2);\r\n  border-radius: 14px;\r\n  background: linear-gradient(145deg, #fff3f7, #f3d5e0);\r\n  box-shadow: 0 6px 16px rgba(152, 74, 103, 0.1);\r\n  color: #a94368;\r\n}\r\n\r\n.auth-brand-mark {\r\n  width: 34px;\r\n  height: 34px;\r\n  border: 1px solid rgba(255, 239, 245, 0.72);\r\n  border-radius: 11px;\r\n  background: linear-gradient(145deg, #fff5f8, #f5d7e2);\r\n  box-shadow: 0 5px 14px rgba(20, 10, 16, 0.16);\r\n  color: #a94368;\r\n}\r\n\r\n.auth-brand-name {\r\n  color: inherit;\r\n}\r\n\r\n.fashion-collection-section,\r\n.fashion-brand-section {\r\n  scroll-margin-top: 24px;\r\n}\r\n\r\n.fashion-brand-section {\r\n  width: min(1450px, calc(100% - 80px));\r\n  margin: 0 auto;\r\n  padding: 34px 0 48px;\r\n}\r\n\r\n.fashion-brand-section .fashion-section-heading {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.fashion-brand-section .fashion-section-heading h2 {\r\n  color: #482f3a;\r\n}\r\n\r\n.fashion-brand-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 205px), 1fr));\r\n  gap: 14px;\r\n}\r\n\r\n.fashion-brand-card {\r\n  display: grid;\r\n  min-width: 0;\r\n  min-height: 168px;\r\n  justify-items: center;\r\n  align-content: center;\r\n  gap: 11px;\r\n  padding: 22px 18px;\r\n  border: 1px solid rgba(190, 112, 142, 0.22);\r\n  border-radius: 20px;\r\n  background:\r\n    radial-gradient(ellipse at 50% 0%, rgba(255, 255, 255, 0.88), transparent 68%),\r\n    linear-gradient(145deg, #fff7fa, #f9e5ed);\r\n  box-shadow: 0 10px 28px rgba(152, 74, 103, 0.08);\r\n  text-align: center;\r\n}\r\n\r\n.fashion-brand-logo {\r\n  display: grid;\r\n  width: 56px;\r\n  height: 56px;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  border: 1px solid rgba(190, 112, 142, 0.18);\r\n  border-radius: 18px;\r\n  background: linear-gradient(145deg, #fff, #f4dce5);\r\n  color: #a94368;\r\n}\r\n\r\n.fashion-brand-logo img {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  padding: 7px;\r\n  object-fit: contain;\r\n}\r\n\r\n.fashion-brand-fallback {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.safe-image-unavailable {\r\n  width: 100%;\r\n  height: 100%;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  padding: 18px;\r\n  overflow: hidden;\r\n  border-radius: inherit;\r\n  background: #f4f0ed;\r\n  color: #735e55;\r\n  text-align: center;\r\n}\r\n\r\n.safe-image-unavailable > span {\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.safe-image-unavailable > strong {\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n  font-size: 14px;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.fashion-brand-card > strong {\r\n  color: #583647;\r\n  font-size: 14px;\r\n  font-weight: 750;\r\n}\r\n\r\n.fashion-brand-card > p {\r\n  display: -webkit-box;\r\n  max-width: 320px;\r\n  margin: 0;\r\n  overflow: hidden;\r\n  color: #896d7b;\r\n  font-size: 11px;\r\n  line-height: 1.6;\r\n  -webkit-box-orient: vertical;\r\n  -webkit-line-clamp: 2;\r\n}\r\n\r\n.fashion-brand-message {\r\n  margin: 0;\r\n  padding: 24px;\r\n  border: 1px dashed rgba(190, 112, 142, 0.32);\r\n  border-radius: 16px;\r\n  background: rgba(255, 255, 255, 0.48);\r\n  color: #806777;\r\n  font-size: 13px;\r\n  text-align: center;\r\n}\r\n\r\n@media (max-width: 800px) {\r\n  .fashion-brand-section {\r\n    width: calc(100% - 32px);\r\n    padding: 24px 0 36px;\r\n  }\r\n}\r\n\r\n@media (max-width: 620px) {\r\n  .fashion-brand-section {\r\n    width: calc(100% - 28px);\r\n  }\r\n\r\n  .fashion-brand-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 10px;\r\n  }\r\n\r\n  .fashion-brand-card {\r\n    min-height: 150px;\r\n    padding: 18px 12px;\r\n    border-radius: 16px;\r\n  }\r\n\r\n  .fashion-brand-logo {\r\n    width: 48px;\r\n    height: 48px;\r\n    border-radius: 15px;\r\n  }\r\n}\r\n\r\n.auth-shell {\r\n  background:\r\n    radial-gradient(ellipse at 10% 10%, rgba(246, 190, 211, 0.34), transparent 40%),\r\n    linear-gradient(135deg, #fff7fa, #fbeaf0 52%, #fff3f6);\r\n}\r\n\r\n.auth-layout {\r\n  background: transparent;\r\n  color: #512f3e;\r\n}\r\n\r\n.auth-showcase {\r\n  isolation: isolate;\r\n  background:\r\n    radial-gradient(ellipse at 20% 12%, rgba(255, 247, 250, 0.74), transparent 40%),\r\n    linear-gradient(145deg, #d887a3, #a94d70 58%, #71384f);\r\n}\r\n\r\n.auth-showcase::before {\r\n  z-index: 0;\r\n  background:\r\n    linear-gradient(105deg, rgba(119, 48, 75, 0.48), rgba(150, 62, 94, 0.24) 54%, rgba(82, 39, 57, 0.56)),\r\n    linear-gradient(180deg, rgba(255, 235, 243, 0.12), rgba(72, 34, 52, 0.58));\r\n}\r\n\r\n.auth-showcase::after {\r\n  background: radial-gradient(circle, rgba(255, 214, 228, 0.46), rgba(255, 214, 228, 0) 68%);\r\n}\r\n\r\n.auth-showcase-image {\r\n  z-index: -1;\r\n  filter: saturate(0.82) sepia(0.08);\r\n}\r\n\r\n.auth-brand {\r\n  color: #fff8fb;\r\n}\r\n\r\n.auth-brand-mark {\r\n  border-color: rgba(255, 255, 255, 0.42);\r\n  background: linear-gradient(145deg, #fff8fb, #f4d7e2);\r\n  box-shad