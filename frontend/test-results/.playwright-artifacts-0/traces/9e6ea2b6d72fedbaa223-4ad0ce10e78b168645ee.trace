}\r\n\r\n.profile-identity h1 {\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: clamp(32px, 3.6vw, 46px);\r\n  font-weight: 600;\r\n}\r\n\r\n.profile-identity p {\r\n  color: #d9d1c7;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.profile-completion {\r\n  display: grid;\r\n  gap: 10px;\r\n  padding: 14px;\r\n  border: 1px solid rgba(255, 253, 249, 0.16);\r\n  border-radius: 8px;\r\n  background: rgba(255, 253, 249, 0.08);\r\n}\r\n\r\n.profile-completion > div:first-child {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n\r\n.profile-completion span {\r\n  color: #d9d1c7;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.profile-completion strong {\r\n  color: #f5d18d;\r\n  font-size: 22px;\r\n}\r\n\r\n.profile-progress-track {\r\n  height: 8px;\r\n  overflow: hidden;\r\n  border-radius: 999px;\r\n  background: rgba(255, 253, 249, 0.16);\r\n}\r\n\r\n.profile-progress-track span {\r\n  display: block;\r\n  height: 100%;\r\n  border-radius: inherit;\r\n  background: #d1aa68;\r\n}\r\n\r\n.profile-stat-grid {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 10px;\r\n}\r\n\r\n.profile-stat-grid div {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 6px;\r\n  padding: 12px;\r\n  border-radius: 8px;\r\n  background: rgba(255, 253, 249, 0.09);\r\n}\r\n\r\n.profile-stat-grid span {\r\n  color: #c4b9ad;\r\n  font-size: 11px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.profile-stat-grid strong {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.profile-edit-panel {\r\n  padding: clamp(18px, 3vw, 28px);\r\n}\r\n\r\n.profile-panel-heading {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n  align-items: flex-start;\r\n  padding-bottom: 16px;\r\n  border-bottom: 1px solid #eee7de;\r\n}\r\n\r\n.profile-panel-heading .eyebrow {\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.profile-panel-heading span {\r\n  max-width: 260px;\r\n  overflow-wrap: anywhere;\r\n  border-radius: 999px;\r\n  padding: 8px 11px;\r\n  background: #eee7de;\r\n  color: #554c43;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n}\r\n\r\n.profile-form-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 16px;\r\n}\r\n\r\n.profile-wide-field {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.profile-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 10px;\r\n  align-items: center;\r\n  padding-top: 4px;\r\n}\r\n\r\n.profile-actions button {\r\n  min-width: 126px;\r\n}\r\n\r\n.profile-loading-card {\r\n  min-height: 360px;\r\n  border-radius: 8px;\r\n  background: linear-gradient(90deg, #eee7de 0%, #fffdf9 50%, #eee7de 100%);\r\n  background-size: 220% 100%;\r\n  animation: detail-loading 1.2s ease-in-out infinite;\r\n}\r\n\r\n.product-detail-loading {\r\n  display: grid;\r\n  grid-template-columns: minmax(360px, 0.95fr) minmax(360px, 1.05fr);\r\n  gap: clamp(18px, 3vw, 34px);\r\n}\r\n\r\n.detail-loading-media,\r\n.detail-loading-copy span,\r\n.detail-loading-copy strong,\r\n.detail-loading-copy p {\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  background: linear-gradient(90deg, #eee7de 0%, #fffdf9 50%, #eee7de 100%);\r\n  background-size: 220% 100%;\r\n  animation: detail-loading 1.2s ease-in-out infinite;\r\n}\r\n\r\n.detail-loading-media {\r\n  min-height: 520px;\r\n}\r\n\r\n.detail-loading-copy {\r\n  display: grid;\r\n  align-content: start;\r\n  gap: 16px;\r\n  padding: clamp(18px, 3vw, 28px);\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n}\r\n\r\n.detail-loading-copy span { width: 120px; height: 18px; }\r\n.detail-loading-copy strong { width: 78%; height: 58px; }\r\n.detail-loading-copy p { height: 18px; }\r\n.detail-loading-copy p:last-child { width: 62%; }\r\n\r\n@keyframes detail-loading {\r\n  from { background-position: 100% 0; }\r\n  to { background-position: -100% 0; }\r\n}\r\n\r\n.metric-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.metric-card {\r\n  display: grid;\r\n  gap: 8px;\r\n  padding: 14px;\r\n  border-radius: 8px;\r\n  border: 1px solid #ddd5cb;\r\n  background: #fffdf9;\r\n}\r\n\r\n.metric-card strong {\r\n  font-size: 22px;\r\n}\r\n\r\n.dashboard-page {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.dashboard-hero-panel {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 18px;\r\n  align-items: end;\r\n  padding: 26px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background:\r\n    linear-gradient(145deg, rgba(31, 29, 26, 0.92), rgba(63, 89, 83, 0.9)),\r\n    #1f1d1a;\r\n  color: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42, 34, 26, 0.08);\r\n}\r\n\r\n.dashboard-hero-panel .eyebrow {\r\n  color: #d1aa68;\r\n}\r\n\r\n.dashboard-hero-panel h1 {\r\n  max-width: 760px;\r\n}\r\n\r\n.dashboard-hero-panel p,\r\n.dashboard-hero-panel small {\r\n  color: #d9d1c7;\r\n}\r\n\r\n.dashboard-hero-revenue {\r\n  display: grid;\r\n  gap: 8px;\r\n  justify-items: end;\r\n  min-width: 260px;\r\n  padding: 18px;\r\n  border: 1px solid rgba(255, 253, 249, 0.16);\r\n  border-radius: 8px;\r\n  background: rgba(255, 253, 249, 0.08);\r\n}\r\n\r\n.dashboard-hero-revenue span {\r\n  color: #d1aa68;\r\n  font-size: 12px;\r\n  font-weight: 900;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.dashboard-hero-revenue strong {\r\n  font-size: clamp(26px, 3.2vw, 42px);\r\n  white-space: nowrap;\r\n}\r\n\r\n.dashboard-kpi-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.dashboard-kpi-card,\r\n.dashboard-panel,\r\n.dashboard-action-card {\r\n  min-width: 0;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 12px 28px rgba(42, 34, 26, 0.06);\r\n}\r\n\r\n.dashboard-kpi-card {\r\n  display: grid;\r\n  gap: 8px;\r\n  padding: 16px;\r\n}\r\n\r