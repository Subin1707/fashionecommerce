round: #eee7de;\r\n  color: #554c43;\r\n  font-weight: 900;\r\n}\r\n\r\n.wishlist-product-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n\r\n.wishlist-card-body {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 12px;\r\n  align-content: start;\r\n}\r\n\r\n.wishlist-card-body .eyebrow {\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.wishlist-card-body h2 {\r\n  font-size: 18px;\r\n}\r\n\r\n.wishlist-card-body h2,\r\n.wishlist-card-body p {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.wishlist-card-body p {\r\n  color: #6f6860;\r\n}\r\n\r\n.wishlist-card-meta,\r\n.wishlist-price-row,\r\n.wishlist-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.wishlist-card-meta span {\r\n  border-radius: 999px;\r\n  padding: 7px 10px;\r\n  background: #eee7de;\r\n  color: #554c43;\r\n  font-size: 12px;\r\n  font-weight: 900;\r\n}\r\n\r\n.wishlist-card-meta span.available {\r\n  background: #e0f1e6;\r\n  color: #1e7042;\r\n}\r\n\r\n.wishlist-card-meta span.soldout {\r\n  background: #f3dfdc;\r\n  color: #9d3b3b;\r\n}\r\n\r\n.wishlist-price-row strong {\r\n  color: #1f1d1a;\r\n  font-size: 19px;\r\n}\r\n\r\n.wishlist-price-row del {\r\n  color: #8b8176;\r\n  font-size: 13px;\r\n}\r\n\r\n.wishlist-actions button {\r\n  min-height: 36px;\r\n  padding: 0 12px;\r\n}\r\n\r\n.wishlist-empty-state {\r\n  padding: 18px;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n  color: #6f6860;\r\n  font-weight: 700;\r\n}\r\n\r\n.recommendation-page {\r\n  display: grid;\r\n  gap: 22px;\r\n}\r\n\r\n.recommendation-hero {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 18px;\r\n  align-items: end;\r\n  padding: 26px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background:\r\n    linear-gradient(145deg, rgba(31, 29, 26, 0.92), rgba(58, 91, 86, 0.9)),\r\n    #1f1d1a;\r\n  color: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42, 34, 26, 0.08);\r\n}\r\n\r\n.r