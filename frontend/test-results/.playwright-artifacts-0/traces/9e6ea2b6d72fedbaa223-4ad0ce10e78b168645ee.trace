;\r\n  font-size: 13px;\r\n}\r\n\r\n.mini-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.product-card-actions {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 8px;\r\n  margin-top: 3px;\r\n}\r\n\r\n.product-card-actions button {\r\n  min-width: 0;\r\n  padding: 0 8px;\r\n  font-size: 12px;\r\n}\r\n\r\n.product-detail-link {\r\n  min-height: 34px;\r\n  width: 100%;\r\n  display: inline-flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 8px;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  padding: 0 12px;\r\n  color: #554c43;\r\n  background: #fbf8f3;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  text-decoration: none;\r\n  transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease, transform 180ms ease;\r\n}\r\n\r\n.product-detail-link span:last-child {\r\n  transition: transform 180ms ease;\r\n}\r\n\r\n.product-detail-link:hover {\r\n  border-color: #caa579;\r\n  color: #7f3f2e;\r\n  background: #fffdf9;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.product-detail-link:hover span:last-child {\r\n  transform: translateX(3px);\r\n}\r\n\r\n.product-add-cart-button {\r\n  border: 1px solid #9d533b;\r\n  color: #9d533b;\r\n  background: #fff7f4;\r\n}\r\n\r\n.product-view-button {\r\n  color: #201f1d;\r\n  background: #eee7de;\r\n}\r\n\r\n.product-buy-now-button {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\n.product-add-cart-button:hover,\r\n.product-buy-now-button:hover {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\n.product-buy-now-button:hover {\r\n  background: #7f3f2e;\r\n}\r\n\r\n.detail-add-button {\r\n  width: 100%;\r\n}\r\n\r\n.detail-add-button:disabled,\r\n.product-card-actions button:disabled {\r\n  opacity: 0.65;\r\n  cursor: wait;\r\n}\r\n\r\n.product-inspector {\r\n  position: sticky;\r\n  top: 24px;\r\n}\r\n\r\n.chips {\r\n  display: flex;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.chips.compact {\r\n  min-height: 29px;\r\n  gap: 6px;\r\n}\r\n\r\n.chips.compact span {\r\n  padding: 5px 8px;\r\n  font-size: 11px;\r\n}\r\n\r\ndl {\r\n  display: grid;\r\n  gap: 8px;\r\n  margin: 0;\r\n}\r\n\r\ndl div {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  border-top: 1px solid #eee7de;\r\n  padding-top: 8px;\r\n}\r\n\r\ndt {\r\n  color: #6f6860;\r\n}\r\n\r\ndd {\r\n  margin: 0;\r\n  font-weight: 800;\r\n}\r\n\r\n.two-column {\r\n  display: grid;\r\n  grid-template-columns: 360px minmax(0, 1fr);\r\n  gap: 18px;\r\n  align-items: start;\r\n}\r\n\r\n.product-detail-page {\r\n  display: grid;\r\n  gap: 24px;\r\n}\r\n\r\n.product-detail-experience {\r\n  width: min(1280px, calc(100% - 52px));\r\n  margin: 0 auto;\r\n  display: grid;\r\n  grid-template-columns: minmax(420px, 0.95fr) minmax(360px, 1.05fr);\r\n  gap: clamp(24px, 3vw, 48px);\r\n  align-items: start;\r\n}\r\n\r\n.product-detail-gallery {\r\n  position: sticky;\r\n  top: 24px;\r\n  display: grid;\r\n  gap: 14px;\r\n  min-width: 0;\r\n}\r\n\r\n.detail-back-button {\r\n  width: fit-content;\r\n  min-height: 38px;\r\n  padding: 0 16px;\r\n  border: 1px solid #d8cfc4;\r\n  border-radius: 999px;\r\n  color: #47423b;\r\n  background: rgba(255, 253, 249, 0.9);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  box-shadow: 0 10px 22px rgba(34, 27, 22, 0.04);\r\n}\r\n\r\n.detail-back-button:hover {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\n.detail-hero-image {\r\n  position: relative;\r\n  min-height: 560px;\r\n  aspect-ratio: 4 / 5;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 26px;\r\n  background:\r\n    radial-gradient(circle at 18% 14%, rgba(209, 170, 104, 0.28), transparent 34%),\r\n    linear-gradient(135deg, rgba(157, 83, 59, 0.12), rgba(58, 91, 86, 0.18)),\r\n    #eee7de;\r\n  box-shadow: 0 22px 54px rgba(42, 34, 26, 0.12);\r\n}\r\n\r\n.detail-hero-image img,\r\n.detail-thumbnail img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n\r\n.detail-hero-image img {\r\n  transition: transform 420ms ease;\r\n}\r\n\r\n.detail-hero-image:hover img {\r\n  transform: scale(1.035);\r\n}\r\n\r\n.detail-image-badges {\r\n  position: absolute;\r\n  z-index: 2;\r\n  top: 14px;\r\n  left: 14px;\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.detail-image-badges span {\r\n  border-radius: 999px;\r\n  padding: 7px 10px;\r\n  color: #17120d;\r\n  background: rgba(255, 253, 249, 0.88);\r\n  box-shadow: 0 8px 18px rgba(32, 31, 29, 0.12);\r\n  font-size: 11px;\r\n  font-weight: 900;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.detail-image-fallback {\r\n  display: grid;\r\n  gap: 8px;\r\n  padding: 26px;\r\n  text-align: center;\r\n  color: #554c43;\r\n}\r\n\r\n.detail-image-fallback strong {\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: 34px;\r\n  font-weight: 600;\r\n}\r\n\r\n.detail-image-fallback span {\r\n  color: #6f6860;\r\n  font-size: 13px;\r\n}\r\n\r\n.detail-thumbnail-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.detail-thumbnail {\r\n  aspect-ratio: 1;\r\n  min-height: 0;\r\n  padding: 0;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 14px;\r\n  background: #fffdf9;\r\n  color: #8d8174;\r\n  font-weight: 800;\r\n  box-shadow: 0 10px 20px rgba(40, 31, 25, 0.04);\r\n}\r\n\r\n.detail-thumbnail:hover,\r\n.detail-thumbnail.active {\r\n  border-color: #9d533b;\r\n  outline: 2px solid rgba(157, 83, 59, 0.18);\r\n  outline-offset: 2px;\r\n  background: #fffdf9;\r\n}\r\n\r\n.detail-buy-panel {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 22px;\r\n  padding: clamp(24px, 3vw, 34px);\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 24px;\r\n  background:\r\n    linear-gradient(180deg, rgba(255, 253, 249, 0.96), rgba(251, 248, 243, 0.98)),\r\n    #fffdf9;\r\n  box-shadow: 0 18px 40px rgba(42, 34, 26, 0.08);\r\n}\r\n\r\n.detail-product-heading {\r\n  display: grid;\r\n  gap: 12px;\r\n  padding-bottom: 4px;\r\n}\r\n\r\n.detail-product-heading h1 {\r\n  margin: 0;\r\n  font-size: clamp(32px, 3vw, 52px);\r\n  line-height: 0.98;\r\n  letter-spacing: -0.04em;\r\n}\r\n\r\n.detail-product-heading p {\r\n  color: #726960;\r\n  font-size: 14px;\r\n  line-height: 1.7;\r\n}\r\n\r\n.detail-kicker-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n}\r\n\r\n.detail-kicker-row .eyebrow {\r\n  margin: 0;\r\n}\r\n\r\n.detail-kicker-row > span {\r\n  border-radius: 999px;\r\n  padding: 7px 10px;\r\n  color: #3a5b56;\r\n  background: #e4ece7;\r\n  font-size: 11px;\r\n  font-weight: 900;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.detail-product-heading h1 {\r\n  max-width: 760px;\r\n  font-family: \"Playfair Display\", Georgia, serif;\r\n  font-size: clamp(34px, 4vw, 56px);\r\n  font-weight: 600;\r\n  line-height: 1;\r\n}\r\n\r\n.detail-product-heading p:last-child {\r\n  max-width: 660px;\r\n  color: #6f6860;\r\n  line-height: 1.75;\r\n}\r\n\r\n.detail-price-row,\r\n.detail-rating-row,\r\n.detail-purchase-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.detail-price-row strong {\r\n  font-size: clamp(24px, 3vw, 34px);\r\n  color: #17120d;\r\n}\r\n\r\n.detail-price-row del {\r\n  color: #8d8174;\r\n}\r\n\r\n.detail-rating-row span,\r\n.detail-service-list span {\r\n  border-radius: 999px;\r\n  padding: 8px 11px;\r\n  background: #eee7de;\r\n  color: #554c43;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n}\r\n\r\n.detail-stock-pill.available {\r\n  color: #1e7042;\r\n  background: #e7f1e9;\r\n}\r\n\r\n.detail-stock-pill.low {\r\n  color: #8a5b16;\r\n  background: #f6ead2;\r\n}\r\n\r\n.detail-stock-pill.soldout {\r\n  color: #9d3b3b;\r\n  background: #f5e2df;\r\n}\r\n\r\n.detail-option-group {\r\n  display: grid;\r\n  gap: 10px;\r\n  padding-top: 18px;\r\n  border-top: 1px solid #eee7de;\r\n}\r\n\r\n.detail-option-title {\r\n  color: #47423b;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.detail-swatch-row,\r\n.detail-size-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.detail-swatch-row button,\r\n.detail-size-row button {\r\n  min-height: 42px;\r\n  border: 1px solid transparent;\r\n  color: #201f1d;\r\n  background: #eee7de;\r\n  font-weight: 800;\r\n}\r\n\r\n.detail-swatch-row button.active,\r\n.detail-size-row button.active,\r\n.detail-swatch-row button:hover,\r\n.detail-size-row button:hover {\r\n  color: #fff;\r\n  background: #3a5b56;\r\n}\r\n\r\n.detail-purchase-row {\r\n  display: grid;\r\n  grid-template-columns: 136px minmax(0, 1fr);\r\n  padding-top: 2px;\r\n}\r\n\r\n.detail-quantity-stepper {\r\n  height: 48px;\r\n  display: grid;\r\n  grid-template-columns: 40px 1fr 40px;\r\n  align-items: center;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  background: #fff;\r\n}\r\n\r\n.detail-quantity-stepper button {\r\n  height: 100%;\r\n  min-height: 0;\r\n  border-radius: 0;\r\n  padding: 0;\r\n  color: #201f1d;\r\n  background: transparent;\r\n}\r\n\r\n.detail-quantity-stepper button:hover {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\n.detail-quantity-stepper button:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.detail-quantity-stepper span {\r\n  text-align: center;\r\n  font-weight: 900;\r\n}\r\n\r\n.detail-action-pair {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\r\n  gap: 10px;\r\n  min-width: 0;\r\n}\r\n\r\n.detail-buy-panel .detail-add-button,\r\n.detail-buy-now-button {\r\n  min-height: 48px;\r\n  width: 100%;\r\n  font-size: 13px;\r\n  font-weight: 900;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.detail-buy-panel .detail-add-button {\r\n  border: 1px solid #9d533b;\r\n  color: #9d533b;\r\n  background: #fff7f4;\r\n}\r\n\r\n.detail-buy-panel .detail-add-button:hover {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\n.detail-buy-now-button {\r\n  color: #fff;\r\n  background: #9d533b;\r\n}\r\n\r\n.detail-buy-now-button:hover {\r\n  background: #7f3f2e;\r\n}\r\n\r\n.detail-selection-note {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  align-items: center;\r\n  padding: 12px 14px;\r\n  border: 1px solid #eee7de;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n}\r\n\r\n.detail-selection-note span {\r\n  color: #6f6860;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.detail-selection-note strong {\r\n  text-align: right;\r\n}\r\n\r\n.detail-spec-grid {\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 0 18px;\r\n  padding: 4px 0;\r\n}\r\n\r\n.detail-spec-grid div {\r\n  min-width: 0;\r\n}\r\n\r\n.detail-spec-grid dd {\r\n  max-width: 100%;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.detail-service-list {\r\n  display: grid;\r\n  gap: 8px;\r\n  padding-top: 2px;\r\n}\r\n\r\n.detail-service-list span {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: center;\r\n  border-radius: 8px;\r\n}\r\n\r\n.detail-service-list b {\r\n  color: #9d533b;\r\n  font-size: 11px;\r\n}\r\n\r\n.detail-lower-grid {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.6fr);\r\n  gap: 18px;\r\n  align-items: stretch;\r\n}\r\n\r\n.detail-lower-grid .table-panel {\r\n  border-color: #d7cec3;\r\n  box-shadow: 0 10px 24px rgba(42, 34, 26, 0.06);\r\n}\r\n\r\n.detail-care-panel p {\r\n  line-height: 1.7;\r\n}\r\n\r\n.detail-care-steps {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.detail-care-steps span {\r\n  border-radius: 999px;\r\n  padding: 7px 10px;\r\n  background: #eee7de;\r\n  color: #554c43;\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n}\r\n\r\n.checkout-page {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) minmax(340px, 0.48fr);\r\n  gap: clamp(18px, 3vw, 32px);\r\n  align-items: start;\r\n}\r\n\r\n.checkout-main {\r\n  display: grid;\r\n  gap: 18px;\r\n  min-width: 0;\r\n}\r\n\r\n.checkout-heading {\r\n  display: grid;\r\n  gap: 8px;\r\n}\r\n\r\n.checkout-heading .eyebrow {\r\n  margin: 0;\r\n}\r\n\r\n.checkout-heading h1 {\r\n  max-width: 680px;\r\n}\r\n\r\n.checkout-heading p {\r\n  color: #6f6860;\r\n}\r\n\r\n.checkout-section,\r\n.checkout-summary-panel {\r\n  min-width: 0;\r\n  display: grid;\r\n  gap: 18px;\r\n  padding: 20px;\r\n  border: 1px solid #d7cec3;\r\n  border-radius: 8px;\r\n  background: #fffdf9;\r\n  box-shadow: 0 14px 34px rgba(42, 34, 26, 0.07);\r\n}\r\n\r\n.checkout-section-title {\r\n  display: flex;\r\n  gap: 12px;\r\n  align-items: flex-start;\r\n}\r\n\r\n.checkout-section-title > span {\r\n  width: 32px;\r\n  aspect-ratio: 1;\r\n  display: grid;\r\n  flex: 0 0 auto;\r\n  place-items: center;\r\n  border-radius: 999px;\r\n  background: #1f1d1a;\r\n  color: #fffdf9;\r\n  font-weight: 900;\r\n}\r\n\r\n.checkout-section-title div {\r\n  display: grid;\r\n  gap: 4px;\r\n}\r\n\r\n.checkout-section-title p {\r\n  color: #6f6860;\r\n}\r\n\r\n.checkout-form-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 14px;\r\n}\r\n\r\n.checkout-wide-field {\r\n  grid-column: 1 / -1;\r\n}\r\n\r\n.payment-method-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.payment-method-card {\r\n  cursor: pointer;\r\n  min-height: 120px;\r\n  padding: 14px;\r\n  border: 1px solid #ddd5cb;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;\r\n}\r\n\r\n.payment-method-card:hover,\r\n.payment-method-card.selected {\r\n  transform: translateY(-1px);\r\n  border-color: #a85a3d;\r\n  box-shadow: 0 12px 24px rgba(168, 90, 61, 0.12);\r\n}\r\n\r\n.payment-method-card input {\r\n  width: 18px;\r\n  height: 18px;\r\n}\r\n\r\n.payment-method-card span,\r\n.payment-method-card small {\r\n  display: block;\r\n}\r\n\r\n.payment-method-card span {\r\n  color: #1f1d1a;\r\n  font-size: 14px;\r\n  font-weight: 900;\r\n}\r\n\r\n.payment-method-card small {\r\n  color: #6f6860;\r\n  line-height: 1.45;\r\n}\r\n\r\n.voucher-row {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.voucher-row span {\r\n  border-radius: 999px;\r\n  padding: 9px 12px;\r\n  background: #eee7de;\r\n  color: #554c43;\r\n  font-size: 12px;\r\n  font-weight: 900;\r\n  white-space: nowrap;\r\n}\r\n\r\n.checkout-summary-panel {\r\n  position: sticky;\r\n  top: 24px;\r\n}\r\n\r\n.checkout-summary-heading {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  align-items: flex-start;\r\n}\r\n\r\n.checkout-summary-heading .eyebrow {\r\n  margin: 0 0 5px;\r\n}\r\n\r\n.checkout-summary-heading > strong {\r\n  color: #a85a3d;\r\n  font-size: 22px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.checkout-item-list {\r\n  display: grid;\r\n  gap: 10px;\r\n}\r\n\r\n.checkout-order-item {\r\n  display: grid;\r\n  grid-template-columns: 72px minmax(0, 1fr) auto;\r\n  gap: 12px;\r\n  align-items: center;\r\n  padding: 10px;\r\n  border: 1px solid #eee7de;\r\n  border-radius: 8px;\r\n  background: #fbf8f3;\r\n}\r\n\r\n.checkout-order-image {\r\n  aspect-ratio: 1;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  background: #eee7de;\r\n  color: #554c43;\r\n  font-weight: 900;\r\n}\r\n\r\n.checkout-order-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n\r\n.checkout-order-item strong,\r\n.checkout-order-item p,\r\n.checkout-order-item small {\r\n  display: block;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.checkout-order-item p,\r\n.checkout-order-item small,\r\n.checkout-order-price span,\r\n.checkout-safe-note,\r\n.checkout-empty-note