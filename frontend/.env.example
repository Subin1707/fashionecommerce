# Optional CARTO Positron basemap. Without a key, maps use OpenStreetMap tiles.
# Obtain your own public basemap key: https://carto.com/basemaps/apikey
# Copy this file to .env.local and restart Vite after setting the key.
VITE_CARTO_API_KEY=

# Optional VietQR overrides. Checkout uses the supplied Vietcombank account by default.
VITE_PAYMENT_BANK_CODE=VCB
VITE_PAYMENT_ACCOUNT_NUMBER=1035636313
VITE_PAYMENT_ACCOUNT_NAME=NGUYEN MANH QUYEN
VITE_PAYMENT_BANK_BRANCH=PGD Vĩnh Trụ
